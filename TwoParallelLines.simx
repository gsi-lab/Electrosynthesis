        </Connection>
        <Connection>
          <Name>Conn32</Name>
          <Type>Variable</Type>
          <From>T</From>
          <To>Anode.T</To>
        </Connection>
        <Connection>
          <Name>Conn33</Name>
          <Type>Variable</Type>
          <From>T</From>
