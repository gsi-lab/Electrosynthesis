        <Variable>
          <Name>TotalElectricityCost</Name>
          <Description>Summary total electric power utility cost</Description>
          <Type>Currency / Time</Type>
          <Group>Total Utility Costs</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalNaturalGasCost</Name>
          <Description>Summary total natural gas utility cost</Description>
          <Type>Currency / Time</Type>
          <Group>Total Utility Costs</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalFuelOilCost</Name>
          <Description>Summary total fuel oil utility cost</Description>
          <Type>Currency / Time</Type>
          <Group>Total Utility Costs</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalRefrigerantCost</Name>
          <Description>Summary total refrigerant utility cost</Description>
          <Type>Currency / Time</Type>
          <Group>Total Utility Costs</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalCoolingWaterCost</Name>
          <Description>Summary total cooling water utility cost</Description>
          <Type>Currency / Time</Type>
          <Group>Total Utility Costs</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalBFWCost</Name>
          <Description>Summary total boiler feed water utility cost</Description>
          <Type>Currency / Time</Type>
          <Group>Total Utility Costs</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalPlantAirCost</Name>
          <Description>Summary total plant air utility cost</Description>
          <Type>Currency / Time</Type>
          <Group>Total Utility Costs</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalUtilityCost</Name>
          <Description>Summary total utility costs</Description>
          <Type>Currency / Time</Type>
          <Group>Summary</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalRawMatlCost</Name>
          <Description>Summary total raw material costs</Description>
          <Type>Currency / Time</Type>
          <Group>Summary</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalWasteCost</Name>
          <Description>Summary total waste costs</Description>
          <Type>Currency / Time</Type>
          <Group>Summary</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalCO2eEmissionCost</Name>
          <Description>Summary total CO2e emissions costs</Description>
          <Type>Currency / Time</Type>
          <Group>Summary</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalProductValue</Name>
          <Description>Summary total product sales</Description>
          <Type>Currency / Time</Type>
          <Group>Summary</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalOperatingCost</Name>
          <Description>Summary total operating cost</Description>
          <Type>Currency / Time</Type>
          <Group>Summary</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>FixedCapInvestment</Name>
          <Description>Summary total fixed capital investment</Description>
          <Type>Currency</Type>
          <Group>Summary</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>FWCapInvestment</Name>
          <Description>Summary total fixed and working capital investment</Description>
          <Type>Currency</Type>
          <Group>Summary</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>TotalPurchaseCost</Name>
          <Description>Summary total free on board purchase price of all equipment</Description>
          <Type>Currency</Type>
          <Group>Total Capital Costs</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>TotalCPHXs</Name>
          <Description>Summary total free on board purchase price of heat exchangers</Description>
          <Type>Currency</Type>
          <Group>Total Capital Costs</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>TotalCPPumps</Name>
          <Description>Summary total free on board purchase price of centrifugal pumps (and optional electric motors)</Description>
          <Type>Currency</Type>
          <Group>Total Capital Costs</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>TotalCPComps</Name>
          <Description>Summary total free on board purchase price of compressors (including drivers and shaft coupling)</Description>
          <Type>Currency</Type>
          <Group>Total Capital Costs</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>TotalCPVessels</Name>
          <Description>Summary total free on board purchase price of vessels (including platform and ladders)</Description>
          <Type>Currency</Type>
          <Group>Total Capital Costs</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>TotalCPColumns</Name>
          <Description>Summary total free on board purchase price of columns (including internals, platform and ladders)</Description>
          <Type>Currency</Type>
          <Group>Total Capital Costs</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>LandCost</Name>
          <Description>Summary initial capital investment to purchase land</Description>
          <Type>Currency</Type>
          <Group>Economic Analysis</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>AnnualLaborCost</Name>
          <Description>Summary annual cost of labor to operate and maintain the project</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Group>Economic Analysis</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>SalvageValue</Name>
          <Description>Summary Salvage value of the plant at the end of the project's life</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Group>Economic Analysis</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>NPV</Name>
          <Description>Summary Net Present Value of the project</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Group>Economic Analysis</Group>
          <Favorite />
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>ROI</Name>
          <Description>Summary Return on Investment for the project</Description>
          <Condition>EA</Condition>
          <Type>Fraction</Type>
          <Group>Economic Analysis</Group>
          <Favorite />
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>NetProfit</Name>
          <Description>Summary total profit from the project over the course of the project's life</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Group>Economic Analysis</Group>
          <Favorite />
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>AnnualProfit</Name>
          <Description>Summary annual profit from the project</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Dimension>ConstructionTime+ProjectLife</Dimension>
          <Group>Economic Analysis</Group>
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>COMd</Name>
          <Description>Summary estimated annual cost of manufacturing without depreciation</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Group>Economic Analysis</Group>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>CumulativeCashFlow</Name>
          <Description>Summary cumulative cash flow produced by the project</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Dimension>ConstructionTime+ProjectLife</Dimension>
          <Group>Economic Analysis</Group>
          <Favorite />
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>CashFlow</Name>
          <Description>Summary annual cash flow produced by the project</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Dimension>ConstructionTime+ProjectLife</Dimension>
          <Group>Economic Analysis</Group>
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>Dk</Name>
          <Description>Summary scheduled loss of value to equipment by year due to depreciation</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Dimension>ProjectLife</Dimension>
          <Group>Economic Analysis</Group>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>DiscountCumulativeCashFlow</Name>
          <Description>Summary cumulative cash flow produced by the project using discounted cash flow values</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Dimension>ConstructionTime+ProjectLife</Dimension>
          <Group>Economic Analysis</Group>
          <Favorite />
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>DiscountRate</Name>
          <Description>Summary discount rate to convert cash flow of a given year to its equivalent present value</Description>
          <Condition>EA</Condition>
          <Type>Ratio</Type>
          <Dimension>ConstructionTime+ProjectLife</Dimension>
          <Group>Economic Analysis</Group>
        </Variable>
        <Variable>
          <Name>Ieff</Name>
          <Description>Summary effective interest rate after adjusting for inflation</Description>
          <Type>Fraction</Type>
          <Group>Economic Analysis</Group>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>DeprecPlanCheck</Name>
          <Description>Summary check to make sure the project life is greater than the defined years for depreciation</Description>
          <Condition>EA</Condition>
          <Type>Dimensionless</Type>
        </Variable>
        <Variable>
          <Name>DeprecValueCheck</Name>
          <Description>Summary check to ensure depreciation value does not exceed the total value of fixed capital investment</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>TotalCapInvestment</Name>
          <Description>Summary total capital investment (includes initial, fixed, and working capitals)</Description>
          <Type>Currency</Type>
          <Group>Summary</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>EOC</Name>
          <Description>Summary equivalent operating cost (combines total capital cost with annual operating cost)</Description>
          <Type>Currency / Time</Type>
          <Group>Summary</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalProduct</Name>
          <Description>Summary cumulative amount of product produced over time t</Description>
          <Type>Mass</Type>
          <Group>Summary</Group>
          <Favorite />
          <Min>0</Min>
          <Max>0</Max>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>CumulativeDynCost</Name>
          <Description>Summary cumulative amount of costs accrued over time t</Description>
          <Type>Currency</Type>
          <Group>Summary</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <Favorite />
        </Variable>
        <Variable>
          <Name>CDC</Name>
          <Description>Summary cumulative dynamic cost</Description>
          <Type>Currency</Type>
        </Variable>
        <Variable>
          <Name>dCDCdt</Name>
          <Description>Summary cumulative dynamic cost time derivative</Description>
          <Type>Real</Type>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>LCOP</Name>
          <Description>Summary levelized cost of the product (operating costs per unit product produced)</Description>
          <Type>Currency / Mass</Type>
          <Group>Summary</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <Favorite />
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>ReactorsElectricityCost</Name>
          <Type>Currency / Time</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>NaturalGasCost</Name>
          <Type>Currency / Time</Type>
          <UplevelReference />
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>OPC1</Name>
          <Formula>TotalUtilityCost = TotalLPSteamCost + TotalMPSteamCost + TotalHPSteamCost + TotalElectricityCost + TotalNaturalGasCost + TotalFuelOilCost + TotalRefrigerantCost + TotalCoolingWaterCost + TotalBFWCost + TotalPlantAirCost</Formula>
        </Equation>
        <Equation>
          <Name>OPC2</Name>
          <Formula>TotalRawMatlCost = totalize("RawMatlCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC3</Name>
          <Formula>TotalProductValue = totalize("ProductValue")</Formula>
        </Equation>
        <Equation>
          <Name>OPC4</Name>
          <Formula>TotalWasteCost = totalize("WasteCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC5</Name>
          <Formula>TotalOperatingCost = TotalUtilityCost + TotalRawMatlCost +TotalWasteCost + TotalCO2eEmissionCost</Formula>
        </Equation>
        <Equation>
          <Name>OPC6</Name>
          <Formula>TotalLPSteamCost = totalize("LPSteamCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC7</Name>
          <Formula>TotalMPSteamCost = totalize("MPSteamCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC8</Name>
          <Formula>TotalHPSteamCost = totalize("HPSteamCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC9</Name>
          <Formula>TotalElectricityCost = totalize("ElectricityCost")+ReactorsElectricityCost</Formula>
        </Equation>
        <Equation>
          <Name>OPC10</Name>
          <Formula>TotalNaturalGasCost = totalize("NaturalGasCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC11</Name>
          <Formula>TotalFuelOilCost = totalize("FuelOilCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC12</Name>
          <Formula>TotalRefrigerantCost = totalize("RefrigerantCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC13</Name>
          <Formula>TotalCoolingWaterCost = totalize("CoolingWaterCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC14</Name>
          <Formula>TotalBFWCost = totalize("BFWCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC15</Name>
          <Formula>TotalPlantAirCost = totalize("PlantAirCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC16</Name>
          <Formula>TotalCO2eEmissionCost = CO2eEmission * totalize("CO2e")</Formula>
        </Equation>
        <Equation>
          <Name>Cap1</Name>
          <Formula>TotalCPHXs = totalize("CapExHX.CP")</Formula>
        </Equation>
        <Equation>
          <Name>Cap2</Name>
          <Formula>TotalCPPumps = totalize("CapExPump.CP")</Formula>
        </Equation>
        <Equation>
          <Name>Cap3</Name>
          <Formula>TotalCPComps = totalize("CapExComp.CP")</Formula>
        </Equation>
        <Equation>
          <Name>Cap4</Name>
          <Formula>TotalCPVessels = totalize("CapExVessel.CP")</Formula>
        </Equation>
        <Equation>
          <Name>Cap5</Name>
          <Formula>TotalCPColumns = totalize("CapExCol.CP")</Formula>
        </Equation>
        <Equation>
          <Name>Cap6</Name>
          <Formula>TotalPurchaseCost = totalize("CP")</Formula>
        </Equation>
        <Equation>
          <Name>Cap7</Name>
          <Formula>FixedCapInvestment = 1.05 * Lang_TPI * TotalPurchaseCost</Formula>
        </Equation>
        <Equation>
          <Name>Cap8</Name>
          <Formula>FWCapInvestment = 1.05 * Lang_TCI * TotalPurchaseCost</Formula>
        </Equation>
        <Equation>
          <Name>EA1</Name>
          <Condition>ConstructionRequired</Condition>
          <Formula>CashFlow[i] * ConstructionTime = -FWCapInvestment</Formula>
          <Start>1</Start>
          <End>ConstructionTime</End>
        </Equation>
        <Equation>
          <Name>EA2</Name>
          <Condition>ConstructionRequired</Condition>
          <Formula>CumulativeCashFlow[1] = -LandCost + CashFlow[1] </Formula>
        </Equation>
        <Equation>
          <Name>EA3</Name>
          <Condition>NoConstructionRequired</Condition>
          <Formula>CumulativeCashFlow[1] = -(LandCost + FWCapInvestment) + CashFlow[1] </Formula>
        </Equation>
        <Equation>
          <Name>EA4</Name>
          <Condition>EA</Condition>
          <Formula>CumulativeCashFlow[i] = (CumulativeCashFlow[i-1] + CashFlow[i])</Formula>
          <Start>2</Start>
          <End>ConstructionTime+ProjectLife</End>
        </Equation>
        <Equation>
          <Name>EA5</Name>
          <Condition>EA</Condition>
          <Formula>CashFlow[i] = AnnualProfit[i] + Dk[i - ConstructionTime]</Formula>
          <Start>ConstructionTime+1</Start>
          <End>ConstructionTime+ProjectLife-1</End>
        </Equation>
        <Equation>
          <Name>EA6</Name>
          <Condition>EA</Condition>
          <Formula>CashFlow[i] = AnnualProfit[i] + Dk[i - ConstructionTime] + COMd + SalvageValue</Formula>
          <Start>ConstructionTime+ProjectLife</Start>
          <End>ConstructionTime+ProjectLife</End>
        </Equation>
        <Equation>
          <Name>EA7</Name>
          <Formula>(1 + AnnualInflationRate) * Ieff = (AnnualInterestRate - AnnualInflationRate)</Formula>
        </Equation>
        <Equation>
          <Name>EA8</Name>
          <Condition>EA</Condition>
          <Formula>DiscountRate[1] = (1 + Ieff)</Formula>
        </Equation>
        <Equation>
          <Name>EA9</Name>
          <Condition>EA</Condition>
          <Formula>DiscountRate[i] = DiscountRate[i-1] * (1 + Ieff)</Formula>
          <Start>2</Start>
          <End>ConstructionTime+ProjectLife</End>
        </Equation>
        <Equation>
          <Name>EA10</Name>
          <Condition>ConstructionRequired</Condition>
          <Formula>DiscountCumulativeCashFlow[1] = -LandCost + CashFlow[1] / DiscountRate[1]</Formula>
        </Equation>
        <Equation>
          <Name>EA11</Name>
          <Condition>NoConstructionRequired</Condition>
          <Formula>DiscountCumulativeCashFlow[1] = -(LandCost + FWCapInvestment) + CashFlow[1] / DiscountRate[1]</Formula>
        </Equation>
        <Equation>
          <Name>EA12</Name>
          <Condition>EA</Condition>
          <Formula>DiscountCumulativeCashFlow[i] = DiscountCumulativeCashFlow[i-1] + CashFlow[i] / DiscountRate[i]</Formula>
          <Start>2</Start>
          <End>ConstructionTime+ProjectLife</End>
        </Equation>
        <Equation>
          <Name>EA13</Name>
          <Condition>EA</Condition>
          <Formula>NPV = DiscountCumulativeCashFlow[i]</Formula>
          <Start>ConstructionTime+ProjectLife</Start>
          <End>ConstructionTime+ProjectLife</End>
        </Equation>
        <Equation>
          <Name>EA14</Name>
          <Condition>EA</Condition>
          <Formula>COMd = 0.180 * FixedCapInvestment + 2.73 * AnnualLaborCost + 1.23 * TotalOperatingCost * 31536000</Formula>
        </Equation>
        <Equation>
          <Name>EA15</Name>
          <Condition>ConstructionRequired</Condition>
          <Formula>AnnualProfit[i] = 0</Formula>
          <Start>1</Start>
          <End>ConstructionTime</End>
        </Equation>
        <Equation>
          <Name>EA16</Name>
          <Condition>EA</Condition>
          <Formula>AnnualProfit[i] = (TotalProductValue * 31536000 - COMd - Dk[i - ConstructionTime]) * (1 - AnnualTaxRate)</Formula>
          <Start>ConstructionTime+1</Start>
          <End>ConstructionTime+ProjectLife</End>
        </Equation>
        <Equation>
          <Name>EA17</Name>
          <Condition>EA</Condition>
          <Formula>NetProfit = sum(AnnualProfit)</Formula>
        </Equation>
        <Equation>
          <Name>EA18</Name>
          <Condition>EA</Condition>
          <Formula>(ROI + 1) * max(FixedCapInvestment, 1e-8) = NetProfit</Formula>
        </Equation>
        <Equation>
          <Name>EA19</Name>
          <Condition>EA</Condition>
          <Formula>DeprecPlanCheck = ProjectLife - Deprec.DepreciationTime</Formula>
        </Equation>
        <Equation>
          <Name>EA20</Name>
          <Condition>EA</Condition>
          <Formula>DeprecValueCheck = sum(Dk) - FixedCapInvestment - 1e-3</Formula>
        </Equation>
        <Equation>
          <Name>EA21</Name>
          <Formula>TotalCapInvestment = FWCapInvestment + LandCost</Formula>
        </Equation>
        <Equation>
          <Name>EA22</Name>
          <Description>Equivalent operating cost (86400 is seconds in a day)</Description>
          <Formula>(EOC - TotalOperatingCost) * ((1 + Ieff) ^ ProjectLife - 1) * DaysPerYear * 86400 = TotalCapInvestment * Ieff * (1+Ieff) ^ ProjectLife</Formula>
        </Equation>
        <Equation>
          <Name>LC1</Name>
          <Formula>TotalProduct = totalize("TotalProduct")</Formula>
        </Equation>
        <Equation>
          <Name>LC2</Name>
          <Condition>Dyn</Condition>
          <Formula>der(CDC) = EOC</Formula>
        </Equation>
        <Equation>
          <Name>LC3</Name>
          <Condition>Dyn</Condition>
          <Formula>CumulativeDynCost = CDC</Formula>
        </Equation>
        <Equation>
          <Name>LC4</Name>
          <Condition>Dyn</Condition>
          <Formula>LCOP * max(TotalProduct, 1e-6) = CumulativeDynCost</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>Deprec</Name>
          <Condition>EA</Condition>
          <ModelTypeParameter>DepreciationType</ModelTypeParameter>
        </Model>
      </Models>
      <Groups>
        <Group>
          <Name>Summary</Name>
          <Description>Summary of overall economic estimates</Description>
          <IsExpandedByDefault>true</IsExpandedByDefault>
        </Group>
        <Group>
          <Name>Global Utility Prices</Name>
          <Description>View and edit global utility prices for operating cost estimations</Description>
        </Group>
        <Group>
          <Name>Total Utility Costs</Name>
          <Description>Contribution of each utility to total operating cost</Description>
        </Group>
        <Group>
          <Name>Total Capital Costs</Name>
          <Description>Contribution of each equipment type to total capital cost</Description>
        </Group>
        <Group>
          <Name>Economic Analysis</Name>
          <Description>Metrics for assessing economics</Description>
        </Group>
      </Groups>
      <Messages>
        <Message>
          <Name>ProjectLifetimeRequired</Name>
          <Expression>ProjectLife &lt; 1</Expression>
          <Severity>Error</Severity>
          <DisplayMessage>Lifetime of the project must be at least 1 year or greater. Increase the value of ProjectLife</DisplayMessage>
        </Message>
        <Message>
          <Name>DepreciationNeedsUpdated</Name>
          <Expression>DeprecPlanCheck &lt; 0</Expression>
          <Severity>Error</Severity>
          <DisplayMessage>Lifetime of the project is less than the planned years for depreciation. Replace the current depreciation model with one for your specific project</DisplayMessage>
        </Message>
        <Message>
          <Name>DepreciationTooHigh</Name>
          <Expression>DeprecValueCheck &gt; 0</Expression>
          <Severity>Error</Severity>
          <DisplayMessage>Total depreciation value planned exceeds the fixed capital investment of the project. Ensure the sum of DPercent in your depreciation model does not exceed 1.</DisplayMessage>
        </Message>
      </Messages>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
            <Image>
              <Name>Default</Name>
              <Rendering>
                <Drawing Format="xaml">&lt;Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Fill"&gt;
  &lt;Canvas Width="100" Height="100"&gt;
    &lt;Path StrokeThickness="5" Stroke="Black" Data="M 50,3 a 47,47 0 0 0 0,94 a 47,47 0 0 0 0,-94"&gt;
      &lt;Path.Fill&gt;
        &lt;RadialGradientBrush  GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="1" RadiusY="1" &gt;
          &lt;GradientStop Color="White" Offset="0.0" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/RadialGradientBrush&gt;
      &lt;/Path.Fill&gt;
    &lt;/Path&gt;
    &lt;TextBlock  Width="30" Height="55" Canvas.Left="55" Canvas.Top="20" TextAlignment="Center" FontFamily="Arial" FontSize="55" FontStyle="normal" FontWeight="SemiBold" Foreground="DarkGray" TextWrapping="Wrap"&gt;€&lt;/TextBlock&gt;
    &lt;TextBlock  Width="30" Height="55" Canvas.Left="15" Canvas.Top="20" TextAlignment="Center" FontFamily="Arial" FontSize="55" FontStyle="normal" FontWeight="SemiBold" Foreground="DarkGray" TextWrapping="Wrap"&gt;¥&lt;/TextBlock&gt;
    &lt;TextBlock  Width="100" Height="70" Canvas.Left="0" Canvas.Top="10" TextAlignment="Center" FontFamily="Arial" FontSize="70" FontStyle="normal" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap"&gt;$&lt;/TextBlock&gt;
  &lt;/Canvas&gt;
