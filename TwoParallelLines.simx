          <Max>1</Max>
          <Min>-1</Min>
        </Parameter>
        <Parameter>
          <Name>density</Name>
          <Type>Standard Liquid Density</Type>
          <Default>1410</Default>
        </Parameter>
        <Parameter>
          <Name>viscosity</Name>
          <Type>Viscosity</Type>
          <Default>0.035</Default>
        </Parameter>
        <Parameter>
          <Name>Eeq</Name>
          <Type>Voltage</Type>
          <Default>-0.0014</Default>
          <Global />
          <Min>-10</Min>
        </Parameter>
        <Parameter>
          <Name>scanVolt</Name>
          <Type>Voltage</Type>
          <Default>0.0005</Default>
          <Max>1</Max>
        </Parameter>
        <Parameter>
          <Name>scantime</Name>
          <Type>Time</Type>
          <Default>1</Default>
          <Max>3</Max>
        </Parameter>
        <Parameter>
          <Name>alfa</Name>
          <Type>Dimensionless</Type>
          <Default>0.37</Default>
          <Max>1</Max>
        </Parameter>
        <Parameter>
          <Name>selectivity_ratio</Name>
          <Type>Real</Type>
          <Default>0.9</Default>
        </Parameter>
        <Parameter>
          <Name>Epc</Name>
          <Type>Voltage</Type>
          <Default>-0.00166</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>CurrentMaxRatio</Name>
          <Type>Ratio</Type>
          <Default>0.9</Default>
        </Parameter>
      </Parameters>
      <Conditions>
        <Condition>
          <Name>CC</Name>
          <Expression>false</Expression>
        </Condition>
      </Conditions>
      <Variables>
        <Variable>
          <Name>P</Name>
          <Description>DefKinetics pressure</Description>
          <Type>Pressure</Type>
          <Min>FluidType.PMin</Min>
          <Max>FluidType.PMax</Max>
          <Default>FluidType.Pressure</Default>
        </Variable>
        <Variable>
          <Name>T2</Name>
          <Description>DefKinetics temperature</Description>
          <Type>Temperature</Type>
          <Min>FluidType.TMin</Min>
          <Max>FluidType.TMax</Max>
          <Default>FluidType.Temperature</Default>
        </Variable>
        <Variable>
          <Name>z</Name>
          <Description>DefKinetics molar bulk phase composition</Description>
          <Type>Molar Composition</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>FluidType.Composition</Default>
        </Variable>
        <Variable>
          <Name>C</Name>
          <Description>DefKinetics molar bulk phase concentration</Description>
          <Type>Molar Concentration</Type>
        </Variable>
        <Variable>
          <Name>Rate</Name>
          <Description>DefKinetics component reaction rates</Description>
          <Type>Reaction Rate per Volume</Type>
          <Dimension>FluidType.CompList</Dimension>
        </Variable>
        <Variable>
          <Name>Reaction</Name>
          <Description>DefKinetics Reaction factor</Description>
          <Type>Fraction</Type>
        </Variable>
        <Variable>
          <Name>V</Name>
          <Type>Volume</Type>
          <UplevelReference />
          <Min>1E-06</Min>
        </Variable>
        <Variable>
          <Name>Cx</Name>
          <Type>Molar Concentration</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>FluidType.Composition</Default>
        </Variable>
        <Variable>
          <Name>Heat</Name>
          <Type>Heat Duty</Type>
        </Variable>
        <Variable>
          <Name>Ax</Name>
          <Type>Surface Area</Type>
          <Min>1E-20</Min>
        </Variable>
        <Variable>
          <Name>L</Name>
          <Type>Length</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>ds</Name>
          <Type>Length</Type>
          <UplevelReference />
          <Default>0.01</Default>
        </Variable>
        <Variable>
          <Name>W</Name>
          <Type>Length</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>ActiveRatio</Name>
          <Type>Dimensionless</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>km</Name>
          <Type>Velocity</Type>
        </Variable>
        <Variable>
          <Name>dH</Name>
          <Type>Diameter</Type>
        </Variable>
        <Variable>
          <Name>Re</Name>
          <Type>Real</Type>
          <Max>1000000000</Max>
        </Variable>
        <Variable>
          <Name>Sc</Name>
          <Type>Real</Type>
          <Max>1000000000</Max>
        </Variable>
        <Variable>
          <Name>Sh</Name>
          <Type>Real</Type>
          <Max>1000000000</Max>
        </Variable>
        <Variable>
          <Name>u</Name>
          <Type>Velocity</Type>
        </Variable>
        <Variable>
          <Name>tau</Name>
          <Type>Time</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>NicholsonParam</Name>
          <Type>Real</Type>
        </Variable>
        <Variable>
          <Name>k0</Name>
          <Type>Velocity</Type>
        </Variable>
        <Variable>
          <Name>T</Name>
          <Type>Temperature</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>keff</Name>
          <Type>Velocity</Type>
        </Variable>
        <Variable>
          <Name>Eop</Name>
          <Type>Voltage</Type>
        </Variable>
        <Variable>
          <Name>imax</Name>
          <Type>Current Density</Type>
        </Variable>
        <Variable>
          <Name>DP</Name>
          <Type>Pressure</Type>
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>Rate_Raw</Name>
          <Formula>Rate["1C4ISOET"]=-1*FaradaicEfficiency*(Cx["1C4ISOET"]*keff)/(1+keff/km)*(ActiveRatio/ds)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn1</Name>
          <Formula>Rate[not{"1C4ISOET","IBUPROFN","IBEB"}]=0</Formula>
        </Equation>
        <Equation>
          <Name>Rate_Ibuprofen</Name>
          <Formula>Rate["IBUPROFN"]=(1*FaradaicEfficiency*(Cx["1C4ISOET"]*keff)/(1+keff/km)*(ActiveRatio/ds))*selectivity_ratio</Formula>
        </Equation>
        <Equation>
          <Name>Eqn_Cx</Name>
          <Formula>Cx = StateX.Vl^(-1) * StateX.x</Formula>
        </Equation>
        <Equation>
          <Name>Eqn2</Name>
          <Formula>km=Sh*D/dH</Formula>
        </Equation>
        <Equation>
          <Name>Eqn3</Name>
          <Formula>dH=2*ds*W/(ds+W)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn4</Name>
          <Formula>Re=density*u*dH/viscosity</Formula>
        </Equation>
        <Equation>
          <Name>Eqn5</Name>
          <Formula>Sc=viscosity/(density*D)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn6</Name>
          <Formula>Sh=1.24*Re^(0.58)*Sc^(0.33)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn7</Name>
          <Formula>u=V/40/tau/(W*ds)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn9</Name>
          <Formula>k0=(D*alfa*n*(F/UnitCorrection)*(scanVolt/scantime)/(R*T))^1/2*exp(alfa*n*F/UnitCorrection*(Epc-Eeq)/(R*T)+0.78)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn10</Name>
          <Formula>keff=k0*exp((-alfa*n*(F/UnitCorrection)*(Eop-Eeq))/(R*T))</Formula>
        </Equation>
        <Equation>
          <Name>Eqn11</Name>
          <Formula>Eop=Eeq-R*T/(alfa*n*(F/UnitCorrection))*ln(imax*CurrentMaxRatio*km/(max(k0,10^(-12))*(imax-imax*CurrentMaxRatio)))</Formula>
        </Equation>
        <Equation>
          <Name>Eqn12</Name>
          <Formula>imax=n*(F/UnitCorrection)*Cx["1C4ISOET"]*km</Formula>
        </Equation>
        <Equation>
          <Name>Eqn13</Name>
          <Formula>Rate["IBEB"]=(1*FaradaicEfficiency*(Cx["1C4ISOET"]*keff)/(1+keff/km)*(ActiveRatio/ds))*(1-selectivity_ratio)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn8</Name>
          <Formula>DP=(12*viscosity*L*u/ds^2)*0.001</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>StateX</Name>
          <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
        </Model>
      </Models>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
            <Image>
              <Name>Default</Name>
              <Rendering>
                <Drawing Format="xaml">&lt;Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Fill"&gt;
  &lt;Canvas Width="100" Height="100"&gt;
    &lt;Path StrokeThickness="5" Stroke="Black" Data="M 50,3 a 47,47 0 0 0 0,94 a 47,47 0 0 0 0,-94"&gt;
      &lt;Path.Fill&gt;
        &lt;RadialGradientBrush  GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="1" RadiusY="1" &gt;
          &lt;GradientStop Color="White" Offset="0.0" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/RadialGradientBrush&gt;
      &lt;/Path.Fill&gt;
    &lt;/Path&gt;
    &lt;TextBlock  Width="60" Height="60" Canvas.Left="30" Canvas.Top="15" FontFamily="Arial" FontSize="58" FontStyle="normal" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap"&gt;RM&lt;/TextBlock&gt;
  &lt;/Canvas&gt;
&lt;/Viewbox&gt;</Drawing>
              </Rendering>
            </Image>
          </Images>
        </Icon>
      </GraphicData>
      <Help>
        <Content format="rtfzip"><![CDATA[]]></Content>
      </Help>
    </Model>
    <Model>
      <Type>ElectroRig</Type>
      <Description>Rigorous electrolyzer model for detailed dynamic a control studies.</Description>
      <NamePrefix>EY</NamePrefix>
      <NameStartingNumber>1</NameStartingNumber>
      <Parameters>
        <Parameter>
          <Name>FluidType</Name>
          <Description>ElectroRig fluid type</Description>
          <Type>FluidType</Type>
          <Default>Fluid1</Default>
        </Parameter>
        <Parameter>
          <Name>Geometry</Name>
          <Description>ElectroRig electrode geometry\n    Square: For square electrodes and rectangular electrolyzer\n     Circle: For circular electrodes and cylindrical electrolyzer</Description>
          <Type>Enumeration</Type>
          <Group>Configuration</Group>
          <Default>Circle</Default>
          <Required />
          <Favorite />
          <Values>
            <Value>Square</Value>
            <Value>Circle</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>Ion</Name>
          <Description>ElectroRig permeating ion through membrane for mass balance calculation\n    Proton: For proton exchange membrane electrolysis where H+ is the permeating ion through the membrane\n     Hydroxide: For alkaline electrolysis where OH- is the permeating ion through the membrane</Description>
          <Type>Enumeration</Type>
          <Group>Configuration</Group>
          <Default>Proton</Default>
          <Required />
          <Favorite />
          <Values>
            <Value>Proton</Value>
            <Value>Hydroxide</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>VoltType</Name>
          <Description>ElectroRig replaceable voltage submodel</Description>
          <Type>ModelType</Type>
          <Group>Configuration</Group>
          <Default>Renewables.DefVolt</Default>
          <Required />
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>PermModelType</Name>
          <Description>ElectroRig replaceable permeation submodel option</Description>
          <Type>ModelType</Type>
          <Group>Configuration</Group>
          <Default>Renewables.DefPerm</Default>
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>EffType</Name>
          <Description>ElectroRig replaceable submodel for Faraday efficiency (default option assumes efficiency of 1)</Description>
          <Type>ModelType</Type>
          <Group>Configuration</Group>
          <Default>Renewables.FaradEffPEM</Default>
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>ModeCheck</Name>
          <Description>Global check for mode change warnings while still in Process mode</Description>
          <Type>Enumeration</Type>
          <Group>Configuration</Group>
          <Default>Process</Default>
          <Favorite />
          <Global />
          <Values>
            <Value>Process</Value>
            <Value>AllModes</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>Elevations</Name>
          <Description>Global selection to enable the specification of equipment port elevations.\n     Disabled: disable specifications for port elevations.  The elevation change (DE) can still be specified in the Pipe and PipeRig models.\n     Manual: manually specify port elevations. DE in the Pipe and PipeRig models can be swapped for port elevation specifications.\n     Automatic: automatically calculate port elevations using equipment geometry and configuration options for select models (Column, Drum, etc).\n\nWhen automatic elevations are enabled, an elevation specification must be removed from each inlet stream of impacted models (for example, remove the DE specification from an inlet Pipe).\nOther model elevations must still be manually specified. For an explanation of how port elevations are estimated, see each model's help file.</Description>
          <Type>Enumeration</Type>
          <Default>Disabled</Default>
          <Global />
          <Values>
            <Value>Disabled</Value>
            <Value>Manual</Value>
            <Value>Automatic</Value>
          </Values>
        </Parameter>
      </Parameters>
      <Conditions>
        <Condition>
          <Name>CC</Name>
          <Expression>False</Expression>
        </Condition>
        <Condition>
          <Name>AlkalineA</Name>
          <Description>Alkaline operation on the anode side</Description>
          <Expression>Ion = Hydroxide and AnoConn</Expression>
        </Condition>
        <Condition>
          <Name>ProtonA</Name>
          <Description>PEM operation on the anode side</Description>
          <Expression>Ion = Proton and AnoConn</Expression>
        </Condition>
        <Condition>
          <Name>AlkalineC</Name>
          <Description>Alkaline operation on the cathode side</Description>
          <Expression>Ion = Hydroxide and CatConn</Expression>
        </Condition>
        <Condition>
          <Name>ProtonC</Name>
          <Description>PEM operation on the cathode side</Description>
          <Expression>Ion = Proton and CatConn</Expression>
        </Condition>
        <Condition>
          <Name>Pro</Name>
          <Description>Process mode</Description>
          <Expression>Mode = Process</Expression>
        </Condition>
        <Condition>
          <Name>FD</Name>
          <Description>Fluid Flow or Dynamics mode</Description>
          <Expression>Mode &lt;&gt; Process</Expression>
        </Condition>
        <Condition>
          <Name>AnoConn</Name>
          <Description>Anode inlet is connected</Description>
          <Expression>AnoIn.NumberOfConnections = 1</Expression>
        </Condition>
        <Condition>
          <Name>CatConn</Name>
          <Description>Cathode inlet is connected</Description>
          <Expression>CatIn.NumberOfConnections = 1</Expression>
        </Condition>
        <Condition>
          <Name>InConn</Name>
          <Description>Anode and Cathode are both connected to inlets</Description>
          <Expression>AnoIn.NumberOfConnections = 1 and CatIn.NumberOfConnections = 1</Expression>
        </Condition>
        <Condition>
          <Name>NotInConn</Name>
          <Description>The anode, cathode, or neither are connected to inlets</Description>
          <Expression>not(InConn)</Expression>
        </Condition>
        <Condition>
          <Name>ElecConnCirc</Name>
          <Description>Electrical input is connected and circular geometry is selected</Description>
          <Expression>(ElecIn.NumberOfConnections &gt; 0) and (Geometry = Circle)</Expression>
        </Condition>
        <Condition>
          <Name>NoElecConnCirc</Name>
          <Description>Electrical input is not connected and circular geometry is selected</Description>
          <Expression>(ElecIn.NumberOfConnections = 0) and (Geometry = Circle)</Expression>
        </Condition>
        <Condition>
          <Name>ElecConnSq</Name>
          <Description>Electrical input is connected and square geometry is selected</Description>
          <Expression>(ElecIn.NumberOfConnections &gt; 0) and (Geometry = Square)</Expression>
        </Condition>
        <Condition>
          <Name>NoElecConnSq</Name>
          <Description>Electrical input is not connected and square geometry is selected</Description>
          <Expression>(ElecIn.NumberOfConnections = 0) and (Geometry = Square)</Expression>
        </Condition>
        <Condition>
          <Name>Square</Name>
          <Description>Square geometry is selected</Description>
          <Expression>Geometry = Square</Expression>
        </Condition>
        <Condition>
          <Name>Circle</Name>
          <Description>Circular geometry is selected</Description>
          <Expression>Geometry = Circle</Expression>
        </Condition>
        <Condition>
          <Name>ElevCirc</Name>
          <Description>Elevations are calculated</Description>
          <Expression>Elevations &lt;&gt; Disabled and Geometry = Circle</Expression>
        </Condition>
        <Condition>
          <Name>ElevSq</Name>
          <Description>Elevations are calculated</Description>
          <Expression>Elevations &lt;&gt; Disabled and Geometry = Square</Expression>
        </Condition>
        <Condition>
          <Name>Elev</Name>
          <Description>Elevations are calculated</Description>
          <Expression>Elevations &lt;&gt; Disabled</Expression>
        </Condition>
        <Condition>
          <Name>MC</Name>
          <Description>Checking for mode warnings</Description>
          <Expression>ModeCheck = AllModes or Mode &lt;&gt; Process</Expression>
        </Condition>
        <Condition>
          <Name>MCCat</Name>
          <Description>Mode check warnings for cathode</Description>
          <Expression>MC and (CatIn.NumberOfConnections=1 or CatOut.NumberOfConnections=1)</Expression>
        </Condition>
        <Condition>
          <Name>MCAno</Name>
          <Description>Mode check warnings for anode</Description>
          <Expression>MC and (AnoIn.NumberOfConnections=1 or AnoOut.NumberOfConnections=1)</Expression>
        </Condition>
      </Conditions>
      <Connections>
        <Connection>
          <Name>Conn1</Name>
          <Type>Port</Type>
          <From>Catin</From>
          <To>Cathode.In</To>
        </Connection>
        <Connection>
          <Name>Conn2</Name>
