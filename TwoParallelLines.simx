        &lt;TextBlock  Width="20" Height="20" Canvas.Left="28" Canvas.Top="45" FontFamily="Arial" FontSize="5" FontStyle="normal" FontWeight="SemiBold" Foreground="#FF000000"&gt;2&lt;/TextBlock&gt;
        &lt;TextBlock  Width="20" Height="20" Canvas.Left="69.5" Canvas.Top="40" FontFamily="Arial" FontSize="9" FontStyle="normal" FontWeight="SemiBold" Foreground="#FF000000"&gt;H&lt;/TextBlock&gt;
        &lt;TextBlock  Width="20" Height="20" Canvas.Left="76" Canvas.Top="45" FontFamily="Arial" FontSize="5" FontStyle="normal" FontWeight="SemiBold" Foreground="#FF000000"&gt;2&lt;/TextBlock&gt;
        &lt;TextBlock  Width="20" Height="20" Canvas.Left="22.5" Canvas.Top="65" FontFamily="Arial" FontSize="12" FontStyle="normal" FontWeight="SemiBold" Foreground="#FF000000"&gt;+&lt;/TextBlock&gt;
