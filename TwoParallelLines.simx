      <Help>
        <Content format="rtfzip"><![CDATA[]]></Content>
      </Help>
    </Model>
    <Model>
      <Type>PFR</Type>
      <Description>Plug flow reactor</Description>
      <NamePrefix>R</NamePrefix>
      <NameStartingNumber>1</NameStartingNumber>
      <HideType />
      <Parameters>
        <Parameter>
          <Name>FluidType</Name>
          <Description>PFR reactor fluid type</Description>
          <Type>FluidType</Type>
          <Default>Process.DefFluid</Default>
        </Parameter>
        <Parameter>
          <Name>FluidReactions</Name>
          <Description>PFR option to include or ignore fluid state reactions</Description>
          <Type>Enumeration</Type>
          <Group>Configuration</Group>
          <Default>Include</Default>
          <Favorite />
          <Values>
            <Value>Ignore</Value>
            <Value>Include</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>Operation</Name>
          <Description>PFR reactor thermal operation\n     Isothermal: reactor operates at a constant temperature (specify T2)\n     Utility: connect reactor duty to an external utility stream for heating or cooling\n     Adiabatic: no heat transfer into or out of reactor (Duty = 0)\n     Profile: define a custom temperature profile</Description>
          <Type>Enumeration</Type>
          <Group>Calculation Options</Group>
          <Default>Isothermal</Default>
          <Favorite />
          <Values>
            <Value>Isothermal</Value>
            <Value>Utility</Value>
            <Value>Adiabatic</Value>
            <Value>Profile</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>RxnModelType</Name>
          <Description>PFR reactor model for reaction stoichiometry for entire holdup. It is recommended to set RxnModelType to DefKinetics and to select the reaction model directly on any of the Sep.RxnModelTypeV, Sep.RxnModelTypeL1, or Sep.RxnModelTypeL2 instead. </Description>
          <Type>ModelType</Type>
          <Group>Calculation Options</Group>
          <Default>Process.DefKinetics</Default>
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>RxnModelTypeV</Name>
          <Description>PFR reactor model for reaction stoichiometry for vapor phase holdup</Description>
          <Type>ModelType</Type>
          <Group>Calculation Options</Group>
          <Default>Process.DefKinetics</Default>
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>RxnModelTypeL1</Name>
          <Description>PFR reactor model for reaction stoichiometry for liquid (VLE) or liquid1 (VLLE) phase holdup</Description>
          <Type>ModelType</Type>
          <Group>Calculation Options</Group>
          <Default>Process.DefKinetics</Default>
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>RxnModelTypeL2</Name>
          <Description>PFR reactor model for reaction stoichiometry for liquid2 phase holdup</Description>
          <Type>ModelType</Type>
          <Group>Calculation Options</Group>
          <Default>Process.DefKinetics</Default>
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>DPModelType</Name>
          <Description>PFR reactor model for pressure drop correlation</Description>
          <Type>ModelType</Type>
          <Group>Calculation Options</Group>
          <Default>Process.RxnDP</Default>
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>Basis</Name>
          <Description>PFR reactor basis for the reaction rate, either by volume or catalyst weight</Description>
          <Type>Enumeration</Type>
          <Group>Calculation Options</Group>
          <Default>Volume</Default>
          <Favorite />
          <Values>
            <Value>Volume</Value>
            <Value>CatalystMass</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>Ne</Name>
          <Description>PFR number of reactor elements\n     Ne represents the number of submodels (discrete elements) that are used to calculate the reaction rates in the PFR model. It is not a representation of any physical aspect of the PFR.\n     More elements give a more accurate solution but require additional computational time and equations.\n     While increasing Ne, observe key variable values (Xmax, T2, etc) to find the minimum number of elements that give the required accuracy for your application.</Description>
          <Type>Integer</Type>
          <Group>Calculation Options</Group>
          <Default>1</Default>
          <Required />
          <Favorite />
          <Max>50</Max>
          <Min>1</Min>
        </Parameter>
        <Parameter>
          <Name>Mm</Name>
          <Description>PFR metal mass for thermal inertia in dynamic mode</Description>
          <Type>Metal Mass</Type>
          <Group>Catalyst Data</Group>
          <Default>1000</Default>
          <Invariant />
          <Max>1000000000000</Max>
          <Min>1E-06</Min>
        </Parameter>
        <Parameter>
          <Name>ModeCheck</Name>
          <Description>Global check for mode change warnings while still in process mode</Description>
          <Type>Enumeration</Type>
          <Group>Configuration</Group>
          <Default>Process</Default>
          <Favorite />
          <Global />
          <Values>
            <Value>Process</Value>
            <Value>AllModes</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>Elevations</Name>
          <Description>Global selection to enable the specification of equipment port elevations.\n     Disabled: disable specifications for port elevations.  The elevation change (DE) can still be specified in the Pipe and PipeRig models.\n     Manual: manually specify port elevations. DE in the Pipe and PipeRig models can be swapped for port elevation specifications.\n     Automatic: automatically calculate port elevations using equipment geometry and configuration options for select models (Column, Drum, etc).\n\nWhen automatic elevations are enabled, an elevation specification must be removed from each inlet stream of impacted models (for example, remove the DE specification from an inlet Pipe).\nOther model elevations must still be manually specified. For an explanation of how port elevations are estimated, see each model's help file.</Description>
          <Type>Enumeration</Type>
          <Default>Disabled</Default>
          <Global />
          <Values>
            <Value>Disabled</Value>
            <Value>Manual</Value>
            <Value>Automatic</Value>
          </Values>
        </Parameter>
      </Parameters>
      <Conditions>
        <Condition>
          <Name>C</Name>
          <Description>Used for debugging</Description>
          <Expression>false</Expression>
        </Condition>
        <Condition>
          <Name>Pro</Name>
          <Description>Process mode</Description>
          <Expression>Mode = Process</Expression>
        </Condition>
        <Condition>
          <Name>IsoTh</Name>
          <Description>Reactor is operated isothermally</Description>
          <Expression>Operation = Isothermal</Expression>
        </Condition>
        <Condition>
          <Name>Utilty</Name>
          <Description>Reactor uses utility heat option</Description>
          <Expression>Operation = Utility</Expression>
        </Condition>
        <Condition>
          <Name>Adiab</Name>
          <Description>Reactor is operated adiabatically</Description>
          <Expression>Operation = Adiabatic</Expression>
        </Condition>
        <Condition>
          <Name>Profile</Name>
          <Description>Reactor temperature is defined by a profile</Description>
          <Expression>Operation = Profile</Expression>
        </Condition>
        <Condition>
          <Name>IsoUtilAd</Name>
          <Description>Isothermal, adiabatic, or utility operation selected</Description>
          <Expression>Operation &lt;&gt; Profile</Expression>
        </Condition>
        <Condition>
          <Name>DefKin</Name>
          <Description>Use this for the dummy kinetics model that allows the PFR to be square on laydown</Description>
          <Expression>RxnModelType = "Process.DefKinetics" and RxnModelTypeV = "Process.DefKinetics" and RxnModelTypeL1 = "Process.DefKinetics" and RxnModelTypeL2 = "Process.DefKinetics"</Expression>
        </Condition>
        <Condition>
          <Name>ProIsoTh</Name>
          <Description>Isothermal operation in process mode</Description>
          <Expression>Pro and IsoThDefKin</Expression>
        </Condition>
        <Condition>
          <Name>UsrKin</Name>
          <Description>User-defined kinetics are defined</Description>
          <Expression>RxnModelType &lt;&gt; "Process.DefKinetics" or RxnModelTypeV &lt;&gt; "Process.DefKinetics" or RxnModelTypeL1 &lt;&gt; "Process.DefKinetics" or (RxnModelTypeL2 &lt;&gt; "Process.DefKinetics" and (FluidType.Phase = VLLE or FluidType.Phase = VLWE))</Expression>
        </Condition>
        <Condition>
          <Name>IsoThUsrKin</Name>
          <Description>User-defined kinetics are defined in isothermal operation</Description>
          <Expression>Operation = Isothermal and UsrKin</Expression>
        </Condition>
        <Condition>
          <Name>IsoThDefKin</Name>
          <Description>Default kinetics are selected in isothermal operation</Description>
          <Expression>Operation = Isothermal and DefKin</Expression>
        </Condition>
        <Condition>
          <Name>DPrig</Name>
          <Description>Rigorous pressure drop model is selected</Description>
          <Expression>DPModelType &lt;&gt; Process.RxnDP</Expression>
        </Condition>
        <Condition>
          <Name>Elev</Name>
          <Description>Elevation</Description>
          <Expression>Elevations &lt;&gt; Disabled</Expression>
        </Condition>
      </Conditions>
      <Connections>
        <Connection>
          <Name>Conn1</Name>
          <Type>Port</Type>
          <From>In</From>
          <To>Elem[1].In</To>
        </Connection>
        <Connection>
          <Name>Conn2</Name>
          <Type>Port</Type>
          <From>Elem[i].Out</From>
          <To>Elem[i+1].In</To>
          <Start>1</Start>
          <End>Ne - 1</End>
        </Connection>
        <Connection>
          <Name>Conn3</Name>
          <Type>Port</Type>
          <From>Elem[Ne].Out</From>
          <To>Out</To>
        </Connection>
        <Connection>
          <Name>Conn4</Name>
          <Type>Variable</Type>
          <From>rhoC</From>
          <To>Elem.rhoc</To>
        </Connection>
        <Connection>
          <Name>Conn5</Name>
          <Type>Variable</Type>
          <From>eps</From>
          <To>Elem.eps</To>
        </Connection>
        <Connection>
          <Name>Conn6</Name>
          <Type>Variable</Type>
          <From>Cpc</From>
          <To>Elem.Cpc</To>
        </Connection>
        <Connection>
          <Name>Conn11</Name>
          <Type>Parameter</Type>
          <From>In.FluidType</From>
          <To>Fluidtype</To>
        </Connection>
        <Connection>
          <Name>Conn10</Name>
          <Type>Parameter</Type>
          <From>Basis</From>
          <To>Elem.Basis</To>
        </Connection>
        <Connection>
          <Name>Conn8</Name>
          <Type>Parameter</Type>
          <From>Fluidtype</From>
          <To>InState.FluidType</To>
        </Connection>
        <Connection>
          <Name>Conn12</Name>
          <Condition>DefKin</Condition>
          <Type>Variable</Type>
          <From>In.z</From>
          <To>InState.z</To>
        </Connection>
        <Connection>
          <Name>Conn14</Name>
          <Condition>DefKin</Condition>
          <Type>Variable</Type>
          <From>In.H</From>
          <To>InState.H</To>
        </Connection>
        <Connection>
          <Name>Conn15</Name>
          <Condition>DefKin</Condition>
          <Type>Variable</Type>
          <From>In.P</From>
          <To>InState.P</To>
        </Connection>
        <Connection>
          <Name>Conn16</Name>
          <Type>Variable</Type>
          <From>DP</From>
          <To>DPCalc.DP</To>
        </Connection>
        <Connection>
          <Name>Conn17</Name>
          <Type>Parameter</Type>
          <From>Ne</From>
          <To>DPCalc.Ne</To>
        </Connection>
        <Connection>
          <Name>Conn13</Name>
          <Type>Variable</Type>
          <From>eps</From>
          <To>DPCalc.eps</To>
        </Connection>
        <Connection>
          <Name>Conn18</Name>
          <Type>Variable</Type>
          <From>D</From>
          <To>DPCalc.D</To>
        </Connection>
        <Connection>
          <Name>Conn7</Name>
          <Type>Variable</Type>
          <From>L</From>
          <To>DPCalc.L</To>
        </Connection>
        <Connection>
          <Name>Conn19</Name>
          <Type>Parameter</Type>
          <From>RxnModelTypeV</From>
          <To>Elem.RxnModelTypeV</To>
        </Connection>
        <Connection>
          <Name>Conn20</Name>
          <Type>Parameter</Type>
          <From>RxnModelTypeL1</From>
          <To>Elem.RxnModelTypeL1</To>
        </Connection>
        <Connection>
          <Name>Conn21</Name>
          <Type>Parameter</Type>
          <From>RxnModelTypeL2</From>
          <To>Elem.RxnModelTypeL2</To>
        </Connection>
        <Connection>
          <Name>Conn9</Name>
          <Type>Parameter</Type>
          <From>RxnModelType</From>
          <To>Elem.RxnModelType</To>
        </Connection>
        <Connection>
          <Name>ConnEl1</Name>
          <Condition>Elev</Condition>
          <Type>Variable</Type>
          <From>In.El</From>
          <To>El1</To>
        </Connection>
        <Connection>
          <Name>ConnEl2</Name>
          <Condition>Elev</Condition>
          <Type>Variable</Type>
          <From>El2</From>
          <To>Out.El</To>
        </Connection>
        <Connection>
          <Name>Conn22</Name>
          <Type>Parameter</Type>
          <From>FluidReactions</From>
          <To>Elem.FluidReactions</To>
        </Connection>
      </Connections>
      <Variables>
        <Variable>
          <Name>Nt</Name>
          <Description>PFR number of tubes</Description>
          <Type>Dimensionless</Type>
          <Group>Reactor Data</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Required />
          <Favorite />
          <Invariant />
          <Max>1000000000</Max>
        </Variable>
        <Variable>
          <Name>L</Name>
          <Description>PFR reactor catalyst bed or tube length</Description>
          <Type>Length</Type>
          <Group>Reactor Data</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Required />
          <Favorite />
          <Invariant />
          <Default>1</Default>
        </Variable>
        <Variable>
          <Name>D</Name>
          <Description>PFR reactor catalyst bed or tube internal diameter</Description>
          <Type>Diameter</Type>
          <Group>Reactor Data</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Invariant />
          <Default>0.1</Default>
        </Variable>
        <Variable>
          <Name>thk</Name>
          <Description>PFR reactor tube thickness</Description>
          <Condition>Utilty</Condition>
          <Type>Thickness</Type>
          <Group>Utility </Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Invariant />
          <Default>5</Default>
        </Variable>
        <Variable>
          <Name>X</Name>
          <Description>PFR reactor conversion for each component</Description>
          <Type>Fraction</Type>
          <Dimension>Fluidtype.CompList</Dimension>
          <Group>Operations</Group>
          <Favorite />
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>Xmax</Name>
          <Description>PFR reactor component conversion maximum value</Description>
          <Type>Fraction</Type>
          <Group>Operations</Group>
          <Favorite />
          <Max>0</Max>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>eps</Name>
          <Description>PFR catalyst void fraction (porosity), defined as the ratio of catalyst void volume to the total catalyst volume.\nEps will affect the conversion when Basis=CatalystMass, and it will affect pressure drop when DPModelType=DPErgun.</Description>
          <Type>Fraction</Type>
          <Group>Catalyst Data</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Invariant />
          <Min>0.001</Min>
          <Max>0.999</Max>
        </Variable>
        <Variable>
          <Name>V</Name>
          <Description>PFR reactor bed or sum of all tube total volume</Description>
          <Type>Volume</Type>
          <Group>Reactor Data</Group>
          <Favorite />
          <Invariant />
          <Min>0</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>T2</Name>
          <Description>PFR outlet temperature</Description>
          <Condition>IsoThDefKin</Condition>
          <Type>Temperature</Type>
          <Group>Operations</Group>
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Min>FluidType.TMin</Min>
          <Max>FluidType.TMax</Max>
        </Variable>
        <Variable>
          <Name>T2</Name>
          <Description>PFR outlet temperature</Description>
          <Condition>IsoThUsrKin</Condition>
          <Type>Temperature</Type>
          <Group>Operations</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Min>FluidType.TMin</Min>
          <Max>FluidType.TMax</Max>
        </Variable>
        <Variable>
          <Name>T2</Name>
          <Description>PFR outlet temperature</Description>
          <Condition>Adiab</Condition>
          <Type>Temperature</Type>
          <Group>Operations</Group>
          <Favorite />
          <Min>FluidType.TMin</Min>
          <Max>FluidType.TMax</Max>
        </Variable>
        <Variable>
          <Name>T2</Name>
          <Description>PFR outlet temperature</Description>
          <Condition>Utilty</Condition>
          <Type>Temperature</Type>
          <Group>Operations</Group>
          <ProcessMode />
          <Favorite />
          <Min>FluidType.TMin</Min>
          <Max>FluidType.TMax</Max>
        </Variable>
        <Variable>
          <Name>T2</Name>
          <Description>PFR outlet temperature</Description>
          <Condition>Profile</Condition>
          <Type>Temperature</Type>
          <Group>Operations</Group>
          <Favorite />
          <Min>FluidType.TMin</Min>
          <Max>FluidType.TMax</Max>
        </Variable>
        <Variable>
          <Name>Duty</Name>
          <Description>PFR reactor heat duty</Description>
          <Type>Heat Duty</Type>
          <Group>Operations</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>T</Name>
          <Description>PFR reactor temperature length profile</Description>
          <Condition>IsoUtilAd</Condition>
          <Type>Temperature</Type>
          <Dimension>Ne</Dimension>
          <Group>Operations</Group>
          <Favorite />
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>T</Name>
          <Description>PFR reactor temperature length profile</Description>
          <Condition>Profile</Condition>
          <Type>Temperature</Type>
          <Dimension>Ne</Dimension>
          <Group>Operations</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Min>FluidType.TMin</Min>
          <Max>FluidType.TMax</Max>
        </Variable>
        <Variable>
          <Name>DP</Name>
          <Description>PFR reactor pressure drop (submodel)</Description>
          <Type>Diff Pressure</Type>
          <Group>Operations</Group>
          <Favorite />
          <Default>50</Default>
        </Variable>
        <Variable>
          <Name>tau</Name>
          <Description>PFR reactor residence time</Description>
          <Type>Time</Type>
          <Group>Reactor Data</Group>
          <Favorite />
          <Max>1000000000</Max>
        </Variable>
        <Variable>
          <Name>Ax</Name>
          <Description>PFR reactor cross-sectional area</Description>
          <Type>Cross Sectional Area</Type>
          <Group>Reactor Data</Group>
          <Invariant />
          <Min>0</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>As</Name>
          <Description>PFR reactor tube surface area in contact with utility</Description>
          <Condition>Utilty</Condition>
          <Type>Surface Area</Type>
          <Group>Utility </Group>
          <Invariant />
          <Min>0</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>Tu</Name>
          <Description>PFR reactor temperature of utility</Description>
          <Condition>Utilty</Condition>
          <Type>Temperature</Type>
          <Group>Utility </Group>
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Min>FluidType.TMin</Min>
          <Max>FluidType.TMax</Max>
          <Default>293</Default>
        </Variable>
        <Variable>
          <Name>U</Name>
          <Description>PFR reactor overall heat transfer coefficient against utility</Description>
          <Condition>Utilty</Condition>
          <Type>Heat Transfer Coefficient</Type>
          <Group>Utility </Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Default>0.065</Default>
        </Variable>
        <Variable>
          <Name>Mc</Name>
          <Description>PFR catalyst mass</Description>
          <Type>Metal Mass</Type>
          <Group>Catalyst Data</Group>
          <ProcessMode Lock="Always">false</ProcessMode>
          <FluidFlowMode Lock="Always">false</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <Invariant />
          <Default>1</Default>
        </Variable>
        <Variable>
          <Name>rhoc</Name>
          <Description>PFR catalyst density</Description>
          <Type>Mass Density</Type>
          <Group>Catalyst Data</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Invariant />
        </Variable>
        <Variable>
          <Name>Cpc</Name>
          <Description>PFR catalyst heat capacity for thermal inertia in dynamic mode</Description>
          <Type>Specific Heat</Type>
          <Group>Catalyst Data</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Invariant />
          <Default>0.68</Default>
        </Variable>
        <Variable>
          <Name>dWfrac</Name>
          <Description>PFR mass imbalance</Description>
          <Condition>Pro</Condition>
          <Type>Fraction</Type>
          <ProcessMode Lock="Always">false</ProcessMode>
          <FluidFlowMode Lock="Always">false</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
        </Variable>
        <Variable>
          <Name>Win</Name>
          <Description>PFR mass inflow</Description>
          <Condition>Pro</Condition>
          <Type>Mass Flow</Type>
          <ProcessMode Lock="Always">false</ProcessMode>
          <FluidFlowMode Lock="Always">false</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
        </Variable>
        <Variable>
          <Name>Wout</Name>
          <Description>PFR mass outflow</Description>
          <Condition>Pro</Condition>
          <Type>Mass Flow</Type>
          <ProcessMode Lock="Always">false</ProcessMode>
          <FluidFlowMode Lock="Always">false</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
        </Variable>
        <Variable>
          <Name>El1</Name>
          <Description>PFR inlet elevation</Description>
          <Condition>Elev</Condition>
          <Type>Elevation</Type>
          <Group>Elevation</Group>
          <Favorite />
          <Min>-1000</Min>
          <Max>1000</Max>
        </Variable>
        <Variable>
          <Name>El2</Name>
          <Description>PFR outlet elevation</Description>
          <Condition>Elev</Condition>
          <Type>Elevation</Type>
          <Group>Elevation</Group>
          <Favorite />
          <Min>-1000</Min>
          <Max>1000</Max>
        </Variable>
        <Variable>
          <Name>DE</Name>
          <Description>PFR elevation change (Out - In)</Description>
          <Condition>Elev</Condition>
          <Type>Length</Type>
          <Group>Elevation</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Min>-1000</Min>
          <Max>1000</Max>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>W</Name>
          <Type>Length</Type>
          <Group>Reactor Data</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Required />
          <Favorite />
          <Invariant />
        </Variable>
        <Variable>
          <Name>ds</Name>
          <Type>Length</Type>
          <Group>Reactor Data</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Required />
          <Favorite />
          <Invariant />
        </Variable>
        <Variable>
          <Name>ActiveRatio</Name>
          <Type>Dimensionless</Type>
          <Required />
          <Favorite />
          <Invariant />
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>ElemVolume</Name>
          <Formula>Elem.V * Ne = V</Formula>
        </Equation>
        <Equation>
          <Name>Eqn4</Name>
          <Formula>Mc = sum(Elem.Mc)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn5</Name>
          <Formula>Elem.Mm * Ne = Mm</Formula>
        </Equation>
        <Equation>
          <Name>Eqn7</Name>
          <Formula>X * max((In.F * In.z), 1E-6) = (In.F * In.z - Out.F * Out.z) </Formula>
        </Equation>
        <Equation>
          <Name>CrossSectionalArea</Name>
          <Description>Electrode Surface Area</Description>
          <Formula>Ax = L * W</Formula>
        </Equation>
        <Equation>
          <Name>TotalVolume</Name>
          <Formula>V = Ax * ds  *ActiveRatio</Formula>
        </Equation>
        <Equation>
          <Name>TotalTime</Name>
          <Formula>tau = sum(Elem.tau)</Formula>
        </Equation>
        <Equation>
          <Name>TotalDuty</Name>
          <Formula>Duty = sum(Elem.Duty)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn12</Name>
          <Formula>Xmax = max(X)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn6</Name>
          <Condition>ProIsoTh</Condition>
          <Formula>InState.T = T2</Formula>
        </Equation>
        <Equation>
          <Name>IsoProfile</Name>
          <Description>PFR temperature profile</Description>
          <Condition>IsoTh</Condition>
          <Formula>T = Elem.T</Formula>
        </Equation>
        <Equation>
          <Name>IsoT2</Name>
          <Condition>IsoTh</Condition>
          <Formula>Elem.T = T2</Formula>
        </Equation>
        <Equation>
          <Name>TempProfile</Name>
          <Condition>Profile</Condition>
          <Formula>T = Elem.T</Formula>
        </Equation>
        <Equation>
          <Name>ProfileT2</Name>
          <Condition>Profile</Condition>
          <Formula>T2 = Elem[Ne].T</Formula>
        </Equation>
        <Equation>
          <Name>AdProfile</Name>
          <Description>PFR temperature profile</Description>
          <Condition>Adiab</Condition>
          <Formula>T = Elem.T</Formula>
        </Equation>
        <Equation>
          <Name>AdT2</Name>
          <Condition>Adiab</Condition>
          <Formula>T2 = Elem[Ne].T</Formula>
        </Equation>
        <Equation>
          <Name>Eqn9</Name>
          <Condition>Adiab</Condition>
          <Formula>Elem.Duty = 0.</Formula>
        </Equation>
        <Equation>
          <Name>UtProfile</Name>
          <Description>PFR temperature profile</Description>
          <Condition>Utilty</Condition>
          <Formula>T = Elem.T</Formula>
        </Equation>
        <Equation>
          <Name>UtT2</Name>
          <Condition>Utilty</Condition>
          <Formula>T2 = Elem[Ne].T</Formula>
        </Equation>
        <Equation>
          <Name>ElemDuty</Name>
          <Condition>Utilty</Condition>
          <Formula>Elem.Duty = U * As * (Tu - Elem.T) / Ne</Formula>
        </Equation>
        <Equation>
          <Name>SurfaceAreaCooling</Name>
          <Condition>Utilty</Condition>
          <Formula>As = Ax * 0.1</Formula>
        </Equation>
        <Equation>
          <Name>CoolantT</Name>
          <Condition>Utilty</Condition>
          <Formula>Utility.T = Tu</Formula>
        </Equation>
        <Equation>
          <Name>CoolantDuty</Name>
          <Condition>Utilty</Condition>
          <Formula>Utility.Duty = - Duty</Formula>
        </Equation>
        <Equation>
          <Name>ElemFlow</Name>
          <Formula>DPCalc.F * Nt = Elem.F</Formula>
        </Equation>
        <Equation>
          <Name>Elemrho</Name>
          <Formula>DPCalc.rho = Elem.rho</Formula>
        </Equation>
        <Equation>
          <Name>ElemMW</Name>
          <Formula>DPCalc.MW = Elem.MWin</Formula>
        </Equation>
        <Equation>
          <Name>PDropEl</Name>
          <Formula>DPCalc.DPElem = Elem.DP</Formula>
        </Equation>
        <Equation>
          <Name>Eqn2</Name>
          <Condition>DPrig</Condition>
          <Formula>DPCalc.mu = Elem.mu</Formula>
        </Equation>
        <Equation>
          <Name>Eqn8</Name>
          <Formula>DPCalc.Lelem = Elem.L</Formula>
        </Equation>
        <Equation>
          <Name>Eqn3</Name>
          <Formula>Out.setp = 0</Formula>
        </Equation>
        <Equation>
          <Name>MB1</Name>
          <Condition>Pro</Condition>
          <Formula>dWfrac * abs(Win) = abs(Win - Wout)</Formula>
        </Equation>
        <Equation>
          <Name>MB2</Name>
          <Condition>Pro</Condition>
          <Formula>Win = sum(In.F * In.z * FluidType.MW)</Formula>
        </Equation>
        <Equation>
          <Name>MB3</Name>
          <Condition>Pro</Condition>
          <Formula>Wout = Out.F * Elem[Ne].MW</Formula>
        </Equation>
        <Equation>
          <Name>EqnEl</Name>
          <Condition>Elev</Condition>
          <Formula>DE = El2 - El1</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>Elem</Name>
          <Dimension>Ne</Dimension>
          <Library Version="9.1.0">Process</Library>
          <Type>PFRElem</Type>
        </Model>
        <Model>
          <Name>DPCalc</Name>
          <ModelTypeParameter>DPModelType</ModelTypeParameter>
        </Model>
        <Model>
          <Name>InState</Name>
          <Condition>DefKin</Condition>
          <ModelTypeParameter>Fluidtype.StateModel</ModelTypeParameter>
        </Model>
      </Models>
      <Ports>
        <Port>
          <Name>In</Name>
          <Library Version="9.1.0">Submodels</Library>
          <Type>FlowPort</Type>
        </Port>
        <Port>
          <Name>Out</Name>
          <Direction>Out</Direction>
          <Library Version="9.1.0">Submodels</Library>
          <Type>FlowPort</Type>
        </Port>
        <Port>
          <Name>Utility</Name>
          <Condition>Utilty</Condition>
          <Direction>Out</Direction>
          <Library Version="9.1.0">Submodels</Library>
          <Type>HeatPort</Type>
        </Port>
      </Ports>
      <Groups>
        <Group>
          <Name>Configuration</Name>
        </Group>
        <Group>
          <Name>Calculation Options</Name>
          <Description>Configuration</Description>
        </Group>
        <Group>
          <Name>Reactor Data</Name>
          <Description>Sizing and geometry data</Description>
        </Group>
        <Group>
          <Name>Catalyst Data</Name>
          <Description>Catalyst and reactor wall material data</Description>
        </Group>
        <Group>
          <Name>Operations</Name>
          <Description>Reaction and operating</Description>
          <IsExpandedByDefault>true</IsExpandedByDefault>
        </Group>
        <Group>
          <Name>Utility </Name>
          <Description>Heat transfer to utility stream</Description>
        </Group>
        <Group>
          <Name>Elevation</Name>
          <Description>Elevation variables for hydraulic calculations. To view and edit elevations, set Elevations = Manual or Automatic.</Description>
        </Group>
      </Groups>
      <Messages>
        <Message>
          <Name>ReduceEps</Name>
          <Expression>eps&gt;0.999</Expression>
          <Severity>Warning</Severity>
          <DisplayMessage>The void fraction must be smaller than 1</DisplayMessage>
        </Message>
        <Message>
          <Name>IncreaseEps</Name>
          <Expression>eps&lt;0.001</Expression>
          <Severity>Warning</Severity>
          <DisplayMessage>The void fraction must be bigger than 0</DisplayMessage>
        </Message>
        <Message>
          <Name>OutletNotConnected</Name>
          <Expression>Out.NumberOfConnections=0</Expression>
          <Severity>Warning</Severity>
          <DisplayMessage>PFR outlet must be connected for Fluid Flow and Dynamics modes.</DisplayMessage>
        </Message>
        <Message>
          <Name>MassBalance</Name>
          <Condition>Pro</Condition>
          <Expression>dWfrac &gt; 1E-3</Expression>
          <Severity>Error</Severity>
          <DisplayMessage>PFR mass balance error. Check the reaction submodel stoichiometry</DisplayMessage>
        </Message>
        <Message>
          <Name>RxnSettingConflict</Name>
          <Expression>RxnModelType &lt;&gt; "Process.DefKinetics" and (RxnModelTypeV &lt;&gt; "Process.DefKinetics" or RxnModelTypeL1 &lt;&gt; "Process.DefKinetics" or RxnModelTypeL2 &lt;&gt; "Process.DefKinetics")</Expression>
          <Severity>Warning</Severity>
          <DisplayMessage>Selecting reaction rates model for entire phase with RxnModelType as well as any phase specifically with RxnModelTypeV/RxnModelTypeL1/RxnModelTypeL2 will be conflicting. Select reaction rates model to either RxnModelType or to one of RxnModelTypeV/RxnModelTypeL1/RxnModelTypeL2 leaving other with Process.DefKinetics..</DisplayMessage>
        </Message>
        <Message>
          <Name>RxnInvalidPhase</Name>
          <Expression>FluidType.Phase = VLE and RxnModelTypeL2 &lt;&gt; "Process.DefKinetics"</Expression>
          <Severity>Warning</Severity>
          <DisplayMessage>RxnModelTypeL2 reaction model will work when fluid phase has VLWE or VLLE.</DisplayMessage>
        </Message>
      </Messages>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
            <Image>
              <Name>Default</Name>
              <Rendering>
                <Drawing Format="xaml">&lt;Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Fill"&gt;
  &lt;Canvas Height="100" Width="100"&gt;
    &lt;Path Data="M 16,20 v 60 h 68 v -60 z"&gt;
      &lt;Path.Fill&gt;
        &lt;LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1.0"&gt;
          &lt;GradientStop Color="#ff707070" Offset="0.0" /&gt;
          &lt;GradientStop Color="White" Offset="0.5" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/LinearGradientBrush&gt;
      &lt;/Path.Fill&gt;
    &lt;/Path&gt;
    &lt;Path Data="M 16,20 a 15,30 0 0 0 0,60 z"&gt;
      &lt;Path.Fill&gt;
        &lt;RadialGradientBrush  GradientOrigin="1.0,0.5" Center="1.0,0.5" RadiusX="1.0" RadiusY="0.5" &gt;
          &lt;GradientStop Color="White" Offset="0.0" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/RadialGradientBrush&gt;
      &lt;/Path.Fill&gt;
