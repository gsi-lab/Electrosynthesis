    <Model>
      <Type>Kinetics</Type>
      <Description>Electrocarboxylation</Description>
      <NamePrefix>R</NamePrefix>
      <NameStartingNumber>1</NameStartingNumber>
      <IsReplaceableModel />
      <Parameters>
        <Parameter>
          <Name>FluidType</Name>
          <Description>DefKinetics fluid type</Description>
          <Type>FluidType</Type>
          <Default>Fluid1</Default>
        </Parameter>
        <Parameter>
          <Name>R</Name>
          <Description>DefKinetics gas constant</Description>
          <Type>Molar Entropy</Type>
          <Default>8.314</Default>
          <Max>10</Max>
        </Parameter>
        <Parameter>
          <Name>Nrxn</Name>
          <Description>DefKinetics number of reactions</Description>
          <Type>Integer</Type>
          <Default>1</Default>
          <Max>100</Max>
          <Min>1</Min>
        </Parameter>
        <Parameter>
          <Name>F</Name>
          <Type>Electrical Charge</Type>
          <Default>96485000</Default>
          <Max>10000000000</Max>
        </Parameter>
        <Parameter>
          <Name>n</Name>
          <Type>Dimensionless</Type>
          <Default>2</Default>
          <Max>5</Max>
        </Parameter>
        <Parameter>
          <Name>FaradaicEfficiency</Name>
          <Type>Dimensionless</Type>
          <Default>1</Default>
          <Global />
          <Max>1</Max>
        </Parameter>
        <Parameter>
          <Name>UnitCorrection</Name>
          <Type>Moles</Type>
          <Default>1</Default>
        </Parameter>
        <Parameter>
          <Name>D</Name>
