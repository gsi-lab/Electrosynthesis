    <Model>
      <Type>Summary</Type>
      <Description>The Summary model provides a central location to view total operating and capital costs and edit global utility costs for the simulation. To use this model, drag it onto your simulation flowsheet.
Default utility costs are provided based on typical process design heuristics. Capital investment is estimated using the Lang factors method. See the model help for more information on the default values.</Description>
      <NamePrefix>EconSummary</NamePrefix>
      <Parameters>
        <Parameter>
          <Name>CEPCI</Name>
          <Description>Global Chemical Engineering Plant Cost Index</Description>
          <Type>Dimensionless</Type>
          <Group>Summary</Group>
          <Default>596.2</Default>
          <Favorite />
          <Global />
        </Parameter>
        <Parameter>
          <Name>DaysPerYear</Name>
          <Description>Summary days of operation per year</Description>
          <Type>Real</Type>
          <Group>Summary</Group>
          <Default>365</Default>
          <Favorite />
          <Max>366</Max>
          <Min>0</Min>
        </Parameter>
        <Parameter>
          <Name>EconomicAnalysis</Name>
          <Description>Summary option to turn on economic analysis tool (for NPV and ROI calculation)</Description>
          <Type>Enumeration</Type>
          <Group>Economic Analysis</Group>
          <Default>Exclude</Default>
          <Favorite />
          <Values>
            <Value>Include</Value>
            <Value>Exclude</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>ConstructionTime</Name>
          <Description>Summary years of construction required to build the project</Description>
          <Type>Integer</Type>
          <Group>Economic Analysis</Group>
          <Default>2</Default>
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>ProjectLife</Name>
          <Description>Summary years of the project's life</Description>
          <Type>Integer</Type>
          <Group>Economic Analysis</Group>
          <Default>10</Default>
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>AnnualTaxRate</Name>
          <Description>Summary annual tax rate for the project</Description>
          <Type>Fraction</Type>
          <Group>Economic Analysis</Group>
          <Default>0.4</Default>
          <Favorite />
          <Max>1</Max>
        </Parameter>
        <Parameter>
          <Name>AnnualInterestRate</Name>
          <Description>Summary annual interest rate for the loans to build the project</Description>
          <Type>Fraction</Type>
          <Group>Economic Analysis</Group>
          <Default>0.1</Default>
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>AnnualInflationRate</Name>
          <Description>Summary annual average inflation rate of the currency</Description>
          <Type>Fraction</Type>
          <Group>Economic Analysis</Group>
          <Default>0.02</Default>
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>DepreciationType</Name>
          <Description>Summary depreciation schedule for the project (default is no depreciation)</Description>
          <Type>ModelType</Type>
          <Group>Economic Analysis</Group>
          <Default>Economics.DefDeprec</Default>
          <Favorite />
        </Parameter>
      </Parameters>
      <Conditions>
        <Condition>
          <Name>EA</Name>
          <Description>Economic analysis is included</Description>
          <Expression>EconomicAnalysis = Include</Expression>
        </Condition>
        <Condition>
          <Name>ConstructionRequired</Name>
          <Expression>ConstructionTime &gt; 0 and EA</Expression>
        </Condition>
        <Condition>
          <Name>NoConstructionRequired</Name>
          <Expression>ConstructionTime = 0 and EA</Expression>
        </Condition>
        <Condition>
          <Name>Dyn</Name>
          <Expression>Mode = Dynamics</Expression>
        </Condition>
      </Conditions>
      <Connections>
        <Connection>
          <Name>Conn2</Name>
          <Condition>EA</Condition>
          <Type>Parameter</Type>
          <From>ProjectLife</From>
          <To>Deprec.ProjectLife</To>
        </Connection>
        <Connection>
          <Name>Conn1</Name>
          <Condition>EA</Condition>
          <Type>Variable</Type>
          <From>FixedCapInvestment</From>
          <To>Deprec.FCI</To>
        </Connection>
        <Connection>
          <Name>Conn3</Name>
          <Condition>EA</Condition>
          <Type>Variable</Type>
          <From>Dk</From>
          <To>Deprec.Dk</To>
        </Connection>
      </Connections>
      <Variables>
        <Variable>
          <Name>Lang_TPI</Name>
          <Description>Summary Lang Factor for calculating total permanent investment. Recommended values:\n     Fluids processing plant: 5.04\n     Solids-fluids processing plant: 4.28\n     Solids processing plant: 3.97</Description>
          <Type>Dimensionless</Type>
          <Group>Summary</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Default>5.04</Default>
        </Variable>
        <Variable>
          <Name>Lang_TCI</Name>
          <Description>Summary Lang Factor for calculating total capital investment. Recommended values:\n     Fluids processing plant: 5.93\n     Solids-fluids processing plant: 5.03\n     Solids processing plant: 4.67</Description>
          <Type>Dimensionless</Type>
          <Group>Summary</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Default>5.93</Default>
        </Variable>
        <Variable>
          <Name>LPSteam</Name>
          <Description>Global low-pressure steam utility price</Description>
          <Type>Currency / Mass</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Global />
          <Default>0.03167</Default>
        </Variable>
        <Variable>
          <Name>MPSteam</Name>
          <Description>Global medium-pressure steam utility price</Description>
          <Type>Currency / Mass</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Global />
          <Default>0.03276</Default>
        </Variable>
        <Variable>
          <Name>HPSteam</Name>
          <Description>Global high-pressure steam utility price</Description>
          <Type>Currency / Mass</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Global />
          <Default>0.03512</Default>
        </Variable>
        <Variable>
          <Name>Electricity</Name>
          <Description>Global electric power utility price</Description>
          <Type>Currency / Energy</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Global />
          <Default>4.49639E-05</Default>
        </Variable>
        <Variable>
          <Name>NaturalGas</Name>
          <Description>Global natural gas utility price</Description>
          <Type>Currency / Volume</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Global />
          <Default>0.11619</Default>
        </Variable>
        <Variable>
          <Name>FuelOil</Name>
          <Description>Global fuel oil utility price</Description>
          <Type>Currency / Volume</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Global />
          <Default>329.158</Default>
        </Variable>
        <Variable>
          <Name>Refrigerant</Name>
          <Description>Global refrigerant utility price</Description>
          <Type>Currency / Energy</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Global />
          <Default>2.909E-05</Default>
        </Variable>
        <Variable>
          <Name>CoolingWater</Name>
          <Description>Global cooling water utility price</Description>
          <Type>Currency / Volume</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Global />
          <Default>0.08672</Default>
        </Variable>
        <Variable>
          <Name>BFW</Name>
          <Description>Global boiler feed water utility price</Description>
          <Type>Currency / Volume</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Global />
          <Default>4.65989</Default>
        </Variable>
        <Variable>
          <Name>PlantAir</Name>
          <Description>Global plant air (compressed and dried) utility price</Description>
          <Type>Currency / Volume</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Global />
          <Default>0.03136</Default>
        </Variable>
        <Variable>
          <Name>CO2eEmission</Name>
          <Description>Global CO2e emissions price (either through a direct carbon tax or purchased carbon credit)</Description>
          <Type>Currency / Mass</Type>
          <Group>Global Utility Prices</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Global />
          <Default>0.025</Default>
        </Variable>
        <Variable>
          <Name>TotalLPSteamCost</Name>
          <Description>Summary total low-pressure steam utility cost</Description>
          <Type>Currency / Time</Type>
          <Group>Total Utility Costs</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalMPSteamCost</Name>
          <Description>Summary total medium-pressure steam utility cost</Description>
          <Type>Currency / Time</Type>
          <Group>Total Utility Costs</Group>
