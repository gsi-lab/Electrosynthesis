    &lt;Path Data="M 84,20 a 15,30 0 0 1 0,60 z"&gt;
      &lt;Path.Fill&gt;
        &lt;RadialGradientBrush  GradientOrigin="0.0,0.5" Center="0.0,0.5" RadiusX="1.0" RadiusY="0.5" &gt;
          &lt;GradientStop Color="White" Offset="0.0" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/RadialGradientBrush&gt;
      &lt;/Path.Fill&gt;
    &lt;/Path&gt;
    &lt;Path Stroke="Black" StrokeThickness="2.5" Data="M 17,20 a 15,30 0 0 0 0,60 h 66 a 15,30 0 0 0 0,-60 h -66"/&gt;
    &lt;Path Stroke="Black" StrokeThickness="1" Data="M 16,20 v 60"/&gt;
    &lt;Path Stroke="Black" StrokeThickness="1" Data="M 84,20 v 60"/&gt;

    &lt;Path Stroke="Black" StrokeThickness="3" Data="M16,30 l68,0"/&gt;
    &lt;Path Stroke="Black" StrokeThickness="3" Data="M16,40 l68,0"/&gt;
    &lt;Path Stroke="Black" StrokeThickness="3" Data="M16,50 l68,0"/&gt;
    &lt;Path Stroke="Black" StrokeThickness="3" Data="M16,60 l68,0"/&gt;
    &lt;Path Stroke="Black" StrokeThickness="3" Data="M16,70 l68,0"/&gt;

  &lt;/Canvas&gt;
&lt;/Viewbox&gt;</Drawing>
              </Rendering>
              <Ports>
                <Port>
                  <Name>In</Name>
                  <X>1.5</X>
                  <Y>50.25</Y>
                </Port>
                <Port>
                  <Name>Out</Name>
                  <X>101.5</X>
                  <Y>50.25</Y>
                </Port>
                <Port>
                  <Name>Utility</Name>
                  <X>51.5</X>
                  <Y>15.25</Y>
                </Port>
              </Ports>
            </Image>
          </Images>
        </Icon>
      </GraphicData>
      <Help>
        <Content format="rtfzip"><![CDATA[]]></Content>
      </Help>
    </Model>
    <Model>
      <Type>RxnSubmodel</Type>
      <Description>Replaceable RxnModelType model for Equilibrium reactions. Designed for use with Fluid1 fluid.</Description>
      <NamePrefix>R</NamePrefix>
      <NameStartingNumber>1</NameStartingNumber>
      <IsReplaceableModel />
      <Parameters>
        <Parameter>
          <Name>FluidType</Name>
          <Type>FluidType</Type>
          <Default>Process.DefFluid</Default>
        </Parameter>
        <Parameter>
          <Name>Nrxn</Name>
          <Description>Rates number of individual reactions</Description>
          <Type>Integer</Type>
          <Default>2</Default>
          <Max>100</Max>
          <Min>1</Min>
        </Parameter>
        <Parameter>
          <Name>Setup</Name>
          <Description>Setup option to either initialize or solve</Description>
          <Type>Enumeration</Type>
          <Group>Reaction Results</Group>
          <Default>Initialize</Default>
          <Favorite />
          <Revertible />
          <Values>
            <Value>Initialize</Value>
            <Value>Solve</Value>
          </Values>
        </Parameter>
      </Parameters>
      <Conditions>
        <Condition>
          <Name>Init</Name>
          <Expression>Setup = Initialize</Expression>
        </Condition>
        <Condition>
          <Name>Solve</Name>
          <Expression>Setup = Solve</Expression>
        </Condition>
      </Conditions>
      <Variables>
        <Variable>
          <Name>P</Name>
          <Description>RxnSubmodel pressure</Description>
          <Type>Pressure</Type>
          <UplevelReference />
          <Min>FluidType.PMin</Min>
          <Max>FluidType.PMax</Max>
          <Default>FluidType.Pressure</Default>
        </Variable>
        <Variable>
          <Name>T</Name>
          <Description>RxnSubmodel temperature</Description>
          <Type>Temperature</Type>
          <Min>FluidType.TMin</Min>
          <Max>FluidType.TMax</Max>
          <Default>FluidType.Temperature</Default>
        </Variable>
        <Variable>
          <Name>z</Name>
          <Description>RxnSubmodel molar bulk phase composition</Description>
          <Type>Molar Composition</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>FluidType.Composition</Default>
        </Variable>
        <Variable>
          <Name>C</Name>
          <Description>RxnSubmodel molar bulk phase concentration</Description>
          <Type>Molar Concentration</Type>
        </Variable>
        <Variable>
          <Name>dz_rxn</Name>
          <Description>RxnSubmodel composition change for reaction's base component</Description>
          <Type>Reaction Rate per Unit Feed</Type>
          <Dimension>Nrxn</Dimension>
          <Min>-1</Min>
          <Max>1</Max>
        </Variable>
        <Variable>
          <Name>Reaction</Name>
          <Description>RxnSubmodel reaction factor</Description>
          <Type>Fraction</Type>
        </Variable>
        <Variable>
          <Name>FlagSolve</Name>
          <Description>Flag used to toggle between initialization and solving</Description>
          <Type>Real</Type>
          <Dimension>Nrxn</Dimension>
          <Min>0</Min>
          <Max>0</Max>
          <Default>1</Default>
        </Variable>
        <Variable>
          <Name>Heat</Name>
          <Description>RxnSubmodel heat adjustment (normally zero as enthalpies include heat of formation)</Description>
          <Type>Heat Duty</Type>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>dz</Name>
          <Description>RxnSubmodel composition change for each component</Description>
          <Type>Reaction Rate per Unit Feed</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Min>-1</Min>
          <Max>1</Max>
        </Variable>
        <Variable>
          <Name>lnKeq</Name>
          <Description>RxnSubmodel natural log of equilibrium constant of each reaction</Description>
          <Type>Dimensionless</Type>
          <Dimension>NRxn</Dimension>
        </Variable>
        <Variable>
          <Name>lnK</Name>
          <Description>RxnSubmodel natural log of equilibrium constant of each reaction</Description>
          <Type>Real</Type>
          <Dimension>NRxn</Dimension>
          <Min>-100</Min>
          <Max>100</Max>
        </Variable>
        <Variable>
          <Name>Cx</Name>
          <Description>RxnSubmodel molar concentration of each component in liquid phase</Description>
          <Type>Molar Concentration</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>FluidType.Composition</Default>
        </Variable>
        <Variable>
          <Name>lnCx</Name>
          <Description>RxnSubmodel logarithmic molar concentration of each component in bulk phase</Description>
          <Type>Real</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Min>-100</Min>
          <Max>20</Max>
          <Default>0</Default>
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>SETUP_Init</Name>
          <Condition>Init</Condition>
          <Formula>dz_rxn = 0</Formula>
        </Equation>
        <Equation>
          <Name>SETUP_Solve</Name>
          <Condition>Solve</Condition>
          <Formula>FlagSolve = 1</Formula>
        </Equation>
        <Equation>
          <Name>HT</Name>
          <Formula>Heat = 0</Formula>
        </Equation>
        <Equation>
          <Name>Eqn_Cx</Name>
          <Formula>Cx = StateX.Vl^(-1) * StateX.x</Formula>
        </Equation>
        <Equation>
          <Name>Eqn_lnCx</Name>
          <Formula>exp(lnCx) = Cx + 1E-12</Formula>
        </Equation>
        <Equation>
          <Name>Eqn1</Name>
          <Formula>dz["H+"] = (1) * dz_rxn[1] + (-1) * dz_rxn[2] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_OH-</Name>
          <Formula>dz["OH-"] = (1) * dz_rxn[1] + (-1) * dz_rxn[2] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_H2O</Name>
          <Formula>dz["H2O"] = (-1) * dz_rxn[1] + (1) * dz_rxn[2] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_Inerts</Name>
          <Description>Inert components not participating in reactions</Description>
          <Formula>dz[not{"H+", "OH-", "H2O"}] = 0</Formula>
        </Equation>
        <Equation>
          <Name>Keq1</Name>
          <Formula>lnKeq[1] = (-13847.26) + (148.97) / T + (-24.498) * ln(T) + (0.0031) * T</Formula>
        </Equation>
        <Equation>
          <Name>K1</Name>
          <Formula>lnK[1] = (-1) * lnCx["H2O"] + (1) * lnCx["OH-"] + (1) * lnCx["H+"]</Formula>
        </Equation>
        <Equation>
          <Name>Keq2</Name>
          <Formula>lnKeq[2] = (-13847.26) + (148.97) / T + (-24.498) * ln(T) + (0.0031) * T</Formula>
        </Equation>
        <Equation>
          <Name>K2</Name>
          <Formula>lnK[2] = (1) * lnCx["H2O"] + (-1) * lnCx["OH-"] + (-1) * lnCx["H+"]</Formula>
        </Equation>
        <Equation>
          <Name>lnKeq_lnK</Name>
          <Formula>lnKeq = FlagSolve * lnK</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>StateX</Name>
          <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
        </Model>
      </Models>
      <Groups>
        <Group>
          <Name>Reaction Results</Name>
        </Group>
      </Groups>
      <Messages>
        <Message>
          <Name>Initialized</Name>
          <Condition>Init</Condition>
          <Expression>Init</Expression>
          <Severity>Warning</Severity>
          <DisplayMessage>Fluid reactions are only initialized. Please open the Reaction Results group and ensure that Setup = Solve for all reactions.</DisplayMessage>
        </Message>
      </Messages>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
            <Image>
              <Name>Default</Name>
              <Rendering>
                <Drawing Format="xaml">&lt;Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Fill"&gt;
  &lt;Canvas Width="100" Height="100"&gt;
    &lt;Path StrokeThickness="5" Stroke="Black" Data="M 50,3 a 47,47 0 0 0 0,94 a 47,47 0 0 0 0,-94"&gt;
      &lt;Path.Fill&gt;
        &lt;RadialGradientBrush  GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="1" RadiusY="1" &gt;
          &lt;GradientStop Color="White" Offset="0.0" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/RadialGradientBrush&gt;
      &lt;/Path.Fill&gt;
    &lt;/Path&gt;
    &lt;TextBlock  Width="60" Height="60" Canvas.Left="30" Canvas.Top="15" FontFamily="Arial" FontSize="58" FontStyle="normal" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap"&gt;RM&lt;/TextBlock&gt;
  &lt;/Canvas&gt;
&lt;/Viewbox&gt;</Drawing>
