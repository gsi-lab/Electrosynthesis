        <Connection>
          <Name>Conn34</Name>
          <Type>Variable</Type>
          <From>CpAno</From>
          <To>Anode.Cp</To>
        </Connection>
        <Connection>
          <Name>Conn35</Name>
          <Type>Variable</Type>
          <From>CpCat</From>
          <To>Cathode.Cp</To>
        </Connection>
        <Connection>
          <Name>Conn36</Name>
          <Type>Variable</Type>
          <From>rhoAno</From>
          <To>Anode.rho</To>
        </Connection>
        <Connection>
          <Name>Conn37</Name>
          <Type>Variable</Type>
          <From>rhoCat</From>
          <To>Cathode.rho</To>
        </Connection>
        <Connection>
          <Name>Conn38</Name>
          <Type>Variable</Type>
          <From>DPa</From>
          <To>Anode.DP</To>
        </Connection>
        <Connection>
          <Name>Conn39</Name>
          <Type>Variable</Type>
          <From>DPc</From>
          <To>Cathode.DP</To>
        </Connection>
        <Connection>
          <Name>Conn40</Name>
          <Type>Variable</Type>
          <From>thke</From>
          <To>Anode.Thke</To>
        </Connection>
        <Connection>
          <Name>Conn41</Name>
          <Type>Variable</Type>
          <From>thke</From>
          <To>Cathode.Thke</To>
        </Connection>
        <Connection>
          <Name>Conn42</Name>
          <Type>Variable</Type>
          <From>Ae</From>
          <To>Anode.Ae</To>
        </Connection>
        <Connection>
          <Name>Conn19</Name>
          <Type>Variable</Type>
          <From>Ncell</From>
          <To>Cathode.Ncell</To>
        </Connection>
        <Connection>
          <Name>Conn47</Name>
          <Type>Variable</Type>
          <From>Ncell</From>
          <To>Anode.Ncell</To>
        </Connection>
        <Connection>
          <Name>Conn48</Name>
          <Condition>Elev</Condition>
          <Type>Variable</Type>
          <From>AnoIn.El</From>
          <To>El1</To>
        </Connection>
        <Connection>
          <Name>Conn49</Name>
          <Condition>Elev</Condition>
          <Type>Variable</Type>
          <From>CatIn.El</From>
          <To>El1</To>
        </Connection>
        <Connection>
          <Name>Conn50</Name>
          <Condition>Elev</Condition>
          <Type>Variable</Type>
          <From>El2</From>
          <To>AnoOut.El</To>
        </Connection>
        <Connection>
          <Name>Conn51</Name>
          <Condition>Elev</Condition>
          <Type>Variable</Type>
          <From>El2</From>
          <To>CatOut.El</To>
        </Connection>
        <Connection>
          <Name>Conn52</Name>
          <Condition>MCCat</Condition>
          <Type>Variable</Type>
          <From>CatIn.setp</From>
          <To>CatInSetP</To>
        </Connection>
        <Connection>
          <Name>Conn53</Name>
          <Condition>MCAno</Condition>
          <Type>Variable</Type>
          <From>AnoIn.setp</From>
          <To>AnoInSetP</To>
        </Connection>
        <Connection>
          <Name>Conn54</Name>
          <Type>Model</Type>
          <From>Cathode.State</From>
          <To>Perm.CatState</To>
        </Connection>
        <Connection>
          <Name>Conn55</Name>
          <Type>Model</Type>
          <From>Anode.State</From>
          <To>Perm.AnoState</To>
        </Connection>
        <Connection>
          <Name>Conn56</Name>
          <Type>Variable</Type>
          <From>Flux</From>
          <To>Cathode.Flux</To>
        </Connection>
        <Connection>
          <Name>Conn59</Name>
          <Type>Variable</Type>
          <From>T</From>
          <To>Heat.T</To>
        </Connection>
      </Connections>
      <Variables>
        <Variable>
          <Name>Ncell</Name>
          <Description>ElectroRig number of cells</Description>
          <Type>Real</Type>
          <Group>Electrolyzer Design</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Required />
          <Favorite />
          <Min>0.0001</Min>
        </Variable>
        <Variable>
          <Name>D</Name>
          <Description>ElectroRig diameter</Description>
          <Condition>ElecConnCirc</Condition>
          <Type>Diameter</Type>
          <Group>Electrolyzer Design</Group>
          <FluidFlowMode />
          <DynamicMode />
          <Required />
          <Favorite />
          <Default>1</Default>
        </Variable>
        <Variable>
          <Name>D</Name>
          <Description>ElectroRig diameter</Description>
          <Condition>NoElecConnCirc</Condition>
          <Type>Diameter</Type>
          <Group>Electrolyzer Design</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Default>1</Default>
        </Variable>
        <Variable>
          <Name>L</Name>
          <Description>ElectroRig length of electrolyzer flow path</Description>
          <Condition>ElecConnSq</Condition>
          <Type>Length</Type>
          <Group>Electrolyzer Design</Group>
          <FluidFlowMode />
          <DynamicMode />
          <Required />
          <Favorite />
          <Default>1</Default>
        </Variable>
        <Variable>
          <Name>L</Name>
          <Description>ElectroRig length of electrolyzer flow path</Description>
          <Condition>NoElecConnSq</Condition>
          <Type>Length</Type>
          <Group>Electrolyzer Design</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Default>1</Default>
        </Variable>
        <Variable>
          <Name>Wcell</Name>
          <Description>ElectroRig width of cell</Description>
          <Type>Length</Type>
          <Group>Electrolyzer Design</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Required />
          <Favorite />
          <Default>0.01</Default>
        </Variable>
        <Variable>
          <Name>Wstack</Name>
          <Description>ElectroRig width of stack</Description>
          <Type>Length</Type>
          <Group>Electrolyzer Design</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>Vcell</Name>
          <Description>ElectroRig cell voltage</Description>
          <Type>Voltage</Type>
          <Group>Operation</Group>
          <Favorite />
          <Default>0.003</Default>
        </Variable>
        <Variable>
          <Name>Vstack</Name>
          <Description>ElectroRig stack voltage</Description>
          <Type>Voltage</Type>
          <Group>Operation</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>LevelAno</Name>
          <Description>ElectroRig anode water level</Description>
          <Type>Fraction</Type>
          <Group>Anode Side</Group>
          <Favorite />
          <Default>0.975</Default>
        </Variable>
        <Variable>
          <Name>LevelCat</Name>
          <Description>ElectroRig cathode water level</Description>
          <Type>Fraction</Type>
          <Group>Cathode Side</Group>
          <Favorite />
          <Default>0.975</Default>
        </Variable>
        <Variable>
          <Name>Pano</Name>
          <Description>ElectroRig anode pressure</Description>
          <Type>Pressure</Type>
          <Group>Anode Side</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>Pcat</Name>
          <Description>ElectroRig cathode pressure</Description>
          <Type>Pressure</Type>
          <Group>Cathode Side</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>T</Name>
          <Description>ElectroRig lumped temperature</Description>
          <Type>Temperature</Type>
          <Group>Operation</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>Ie</Name>
          <Description>ElectroRig electric current</Description>
          <Type>Current</Type>
          <Group>Operation</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>Ae</Name>
          <Description>ElectroRig surface area of single electrode</Description>
          <Type>Surface Area</Type>
          <Group>Electrolyzer Design</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>Astack</Name>
          <Description>ElectroRig total surface area of all electrodes</Description>
          <Type>Surface Area</Type>
          <Group>Electrolyzer Design</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>Epower</Name>
          <Description>ElectroRig energy from electrical power</Description>
          <Condition>NotInConn</Condition>
          <Type>Electrical Power</Type>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Max>0</Max>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>EPower</Name>
          <Description>ElectroRig energy from electrical power</Description>
          <Condition>InConn</Condition>
          <Type>Electrical Power</Type>
          <Max>0</Max>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>derE</Name>
          <Description>ElectroRig total energy of cell time derivative</Description>
          <Type>Heat Duty</Type>
        </Variable>
        <Variable>
          <Name>EAno</Name>
          <Description>ElectroRig total energy in anode</Description>
          <Type>Energy</Type>
        </Variable>
        <Variable>
          <Name>ECat</Name>
          <Description>ElectroRig total energy in cathode</Description>
          <Type>Energy</Type>
        </Variable>
        <Variable>
          <Name>E</Name>
          <Description>ElectroRig total energy of cell</Description>
          <Type>Energy</Type>
        </Variable>
        <Variable>
          <Name>dEdt</Name>
          <Description>ElectroRig total energy of cell time derivative</Description>
          <Type>Real</Type>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>Rate</Name>
          <Description>ElectroRig base rate of conversion</Description>
          <Type>Mole Flow</Type>
          <Max>0</Max>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>RateA</Name>
          <Description>ElectroRig component rates of conversion in anode</Description>
          <Type>Mole Flow</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Group>Anode Side</Group>
          <Favorite />
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>RateC</Name>
          <Description>ElectroRig component rates of conversion in cathode</Description>
          <Type>Mole Flow</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Group>Cathode Side</Group>
          <Favorite />
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>Zano</Name>
          <Description>ElectroRig molar composition in anode</Description>
          <Type>Molar Composition</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Group>Anode Side</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>Zcat</Name>
          <Description>ElectroRig molar composition in cathode</Description>
          <Type>Molar Composition</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Group>Cathode Side</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>Thke</Name>
          <Description>ElectroRig electrode thickness</Description>
          <Type>Thickness</Type>
          <Group>Electrolyzer Design</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Required />
          <Favorite />
        </Variable>
        <Variable>
          <Name>J</Name>
          <Description>ElectroRig electrode current density</Description>
          <Type>Current Density</Type>
          <Group>Electrolyzer Design</Group>
          <ProcessMode />
          <Required />
          <Favorite />
          <Default>10000</Default>
        </Variable>
        <Variable>
          <Name>Vtn</Name>
          <Description>ElectroRig thermal neutral voltage</Description>
          <Type>Voltage</Type>
          <Group>Operation</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>CpAno</Name>
          <Description>ElectroRig specific heat of the anode</Description>
          <Type>Specific Heat</Type>
          <Group>Electrode Data</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
        </Variable>
        <Variable>
          <Name>CpCat</Name>
          <Description>ElectroRig specific heat of the cathode</Description>
          <Type>Specific Heat</Type>
          <Group>Electrode Data</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
        </Variable>
        <Variable>
          <Name>rhoAno</Name>
          <Description>ElectroRig mass density of anode</Description>
          <Type>Mass Density</Type>
          <Group>Electrode Data</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
        </Variable>
        <Variable>
          <Name>rhoCat</Name>
          <Description>ElectroRig mass density of cathode</Description>
          <Type>Mass Density</Type>
          <Group>Electrode Data</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
        </Variable>
        <Variable>
          <Name>Thkm</Name>
          <Description>ElectroRig thickness of the membrane</Description>
          <Type>Thickness</Type>
          <Group>Electrolyzer Design</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Required />
          <Favorite />
          <Default>0.178</Default>
        </Variable>
        <Variable>
          <Name>CpMem</Name>
          <Description>ElectroRig specific heat of membrane</Description>
          <Type>Specific Heat</Type>
          <Group>Electrolyzer Design</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
        </Variable>
        <Variable>
          <Name>rhoMem</Name>
          <Description>ElectroRig mass density of membrane</Description>
          <Type>Mass Density</Type>
          <Group>Electrolyzer Design</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
        </Variable>
        <Variable>
          <Name>DPa</Name>
          <Description>ElectroRig anode-side pressure drop</Description>
          <Type>Diff Pressure</Type>
          <Group>Anode Side</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>DPc</Name>
          <Description>ElectroRig cathode-side pressure drop</Description>
          <Type>Diff Pressure</Type>
          <Group>Cathode Side</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>etaF</Name>
          <Description>ElectroRig Faraday efficiency</Description>
          <Type>Fraction</Type>
          <Group>Operation</Group>
        </Variable>
        <Variable>
          <Name>El1</Name>
          <Description>ElectroRig elevation at the inlet of the electrolyzer</Description>
          <Type>Elevation</Type>
          <Invariant />
        </Variable>
        <Variable>
          <Name>El2</Name>
          <Description>ElectroRig elevation at the outlet of the electrolyzer</Description>
          <Type>Elevation</Type>
          <Invariant />
        </Variable>
        <Variable>
          <Name>CatInSetP</Name>
          <Description>ElectroRig stream pressure set flag from upstream model for mode check warnings   (0 - model sets flow, 1 - model sets pressure)</Description>
          <Condition>MCCat</Condition>
          <Type>Dimensionless</Type>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>AnoInSetP</Name>
          <Description>ElectroRig stream pressure set flag from upstream model for mode check warnings   (0 - model sets flow, 1 - model sets pressure)</Description>
          <Condition>MCAno</Condition>
          <Type>Dimensionless</Type>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>Flux</Name>
          <Description>ElectroRig flux due to permeation across the membrane from the cathode to the anode</Description>
          <Type>Mole Flow</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Group>Operation</Group>
          <Favorite />
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>Contact</Name>
          <Description>ElectroRig contact factor used to assist in solving for a converged solution for permeation calculations</Description>
          <Type>Fraction</Type>
          <Group>Configuration</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>Duty</Name>
          <Description>ElectroRig heat duty removed (specified)</Description>
          <Type>Heat Duty</Type>
          <Group>Operation</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
        </Variable>
        <Variable>
          <Name>HeatDuty</Name>
          <Description>ElectroRig heat duty removed (from external exchanger)</Description>
          <Type>Heat Duty</Type>
          <Dimension>Heat.StreamList</Dimension>
          <Group>Operation</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalDuty</Name>
          <Description>ElectroRig combined heat duty (specified and from heat port)</Description>
          <Type>Heat Duty</Type>
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>Ebal1</Name>
          <Description>Energy balance for process mode</Description>
          <Condition>Pro</Condition>
          <Formula>CatIn.F * CatIn.H + AnoIn.F * AnoIn.H + Ie * Vstack + TotalDuty = CatOut.F * CatOut.H + AnoOut.F * AnoOut.H</Formula>
        </Equation>
        <Equation>
          <Name>Ebal2</Name>
          <Description>Energy balance for fluid flow and dynamics</Description>
          <Condition>FD</Condition>
          <Formula>derE = CatIn.F * CatIn.H + AnoIn.F * AnoIn.H + Ie * Vstack - CatOut.F * CatOut.H - AnoOut.F * AnoOut.H + TotalDuty</Formula>
        </Equation>
        <Equation>
          <Name>Ebal3</Name>
          <Condition>FD</Condition>
          <Formula>der(E) = derE</Formula>
        </Equation>
        <Equation>
          <Name>Ebal4</Name>
          <Description>Total energy holdup of the electrolyzer cell</Description>
          <Formula>E = ECat + EAno + Ae * Thkm / 1000 * Ncell * rhoMem * CpMem * T</Formula>
        </Equation>
        <Equation>
          <Name>Volt1</Name>
          <Description>Voltage of the entire electrolyzer stack</Description>
          <Formula>Vstack = Vcell * Ncell</Formula>
        </Equation>
        <Equation>
          <Name>Volt2</Name>
          <Description>Thermal neutral voltage (96485.332 is Faraday's constant in C/mol)</Description>
          <Formula>1000 * Vtn = FluidType.GHV["H2"] / 2 / 96485.332</Formula>
        </Equation>
        <Equation>
          <Name>Size1</Name>
          <Description>Voltage of a single cell</Description>
          <Formula>Wstack = Wcell * Ncell</Formula>
        </Equation>
        <Equation>
          <Name>Size2</Name>
          <Description>Total area of the electrodes in the stack</Description>
          <Formula>Astack = 2 * Ncell * Ae</Formula>
        </Equation>
        <Equation>
          <Name>CurrDens1</Name>
          <Condition>Pro</Condition>
          <Formula>J * Ae = Ie</Formula>
        </Equation>
        <Equation>
          <Name>CurrDens2</Name>
          <Description>Effective electrical current based on level of water in electrodes</Description>
          <Condition>FD</Condition>
          <Formula>J * Ae * min(LevelAno, LevelCat) = Ie</Formula>
        </Equation>
        <Equation>
          <Name>RateEq1</Name>
          <Description>Conversion of electrical current to moles reacted (96485.332 is Faraday's constant in C/mol)</Description>
          <Formula>Rate * 96485.332 * 1000 = Ie * etaF</Formula>
        </Equation>
        <Equation>
          <Name>RateEq2</Name>
          <Condition>ProtonA</Condition>
          <Formula>RateA["CHLORINE"] = (1/2) * Rate</Formula>
        </Equation>
        <Equation>
          <Name>RateEq4</Name>
          <Condition>ProtonA</Condition>
          <Formula>RateA[not{"CHLORINE"}] = 0</Formula>
        </Equation>
        <Equation>
          <Name>RateEq5</Name>
          <Condition>ProtonC</Condition>
          <Formula>RateC["IBUPROFN"] = (1) * Rate</Formula>
        </Equation>
        <Equation>
          <Name>RateEq6</Name>
          <Condition>ProtonC</Condition>
          <Formula>RateC[not{"1C4ISOET","CO2","IBUPROFN"}] = 0</Formula>
        </Equation>
        <Equation>
          <Name>Eqn2</Name>
          <Formula>CatOut.setp = 0</Formula>
        </Equation>
        <Equation>
          <Name>Eqn1</Name>
          <Formula>AnoOut.setp = 0</Formula>
        </Equation>
        <Equation>
          <Name>Eqn3</Name>
          <Condition>ElevCirc</Condition>
          <Formula>D = El2 - El1</Formula>
        </Equation>
        <Equation>
          <Name>Eqn4</Name>
          <Condition>ElevSq</Condition>
          <Formula>L = El2 - El1</Formula>
        </Equation>
        <Equation>
          <Name>Eqn5</Name>
          <Description>FDPerm</Description>
          <Formula>Anode.Flux = Perm.Flux * Ae * Contact</Formula>
        </Equation>
        <Equation>
          <Name>Eqn6</Name>
          <Formula>Cathode.Flux = -Perm.Flux * Ae * Contact</Formula>
        </Equation>
        <Equation>
          <Name>Eqn7</Name>
          <Formula>TotalDuty = Duty + sum(Heat.Duty)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn8</Name>
          <Formula>HeatDuty = Heat.Duty</Formula>
        </Equation>
        <Equation>
          <Name>Eqn9</Name>
          <Formula>RateC["1C4ISOET"] = (-1) * Rate</Formula>
        </Equation>
        <Equation>
          <Name>Eqn10</Name>
          <Formula>RateC["CO2"] = (-1) * Rate</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>Anode</Name>
          <Library Version="9.1.0">Renewables</Library>
          <Type>Electrode</Type>
        </Model>
        <Model>
          <Name>Cathode</Name>
          <Library Version="9.1.0">Renewables</Library>
          <Type>Electrode</Type>
        </Model>
        <Model>
          <Name>Voltage</Name>
          <ModelTypeParameter>VoltType</ModelTypeParameter>
        </Model>
        <Model>
          <Name>EFF</Name>
          <ModelTypeParameter>EffType</ModelTypeParameter>
        </Model>
        <Model>
          <Name>Perm</Name>
          <ModelTypeParameter>PermModelType</ModelTypeParameter>
        </Model>
      </Models>
      <Ports>
        <Port>
          <Name>CatIn</Name>
          <Library Version="9.1.0">Submodels</Library>
          <Type>FlowPort</Type>
        </Port>
        <Port>
          <Name>AnoIn</Name>
          <Library Version="9.1.0">Submodels</Library>
          <Type>FlowPort</Type>
        </Port>
        <Port>
          <Name>CatOut</Name>
          <Direction>Out</Direction>
          <Library Version="9.1.0">Submodels</Library>
          <Type>FlowPort</Type>
        </Port>
        <Port>
          <Name>AnoOut</Name>
          <Direction>Out</Direction>
          <Library Version="9.1.0">Submodels</Library>
          <Type>FlowPort</Type>
        </Port>
        <Port>
          <Name>ElecIn</Name>
          <Library Version="9.1.0">Renewables</Library>
          <Type>ElecPort</Type>
        </Port>
        <Port>
          <Name>Heat</Name>
          <Connections>Multiple</Connections>
          <Library Version="9.1.0">Submodels</Library>
          <Type>HeatPort</Type>
        </Port>
      </Ports>
      <Groups>
        <Group>
          <Name>Configuration</Name>
        </Group>
        <Group>
          <Name>Electrolyzer Design</Name>
        </Group>
        <Group>
          <Name>Electrode Data</Name>
        </Group>
        <Group>
          <Name>Operation</Name>
          <IsExpandedByDefault>true</IsExpandedByDefault>
        </Group>
        <Group>
          <Name>Anode Side</Name>
        </Group>
        <Group>
          <Name>Cathode Side</Name>
        </Group>
      </Groups>
      <Messages>
        <Message>
          <Name>CathodeOutletNotConnected</Name>
          <Condition>MC</Condition>
          <Expression>CatIn.NumberOfConnections = 1 and CatOut.NumberOfConnections = 0</Expression>
          <Severity>Warning</Severity>
          <DisplayMessage>ElectroRig cathode outlet must be connected for Fluid Flow and Dynamics modes.</DisplayMessage>
        </Message>
        <Message>
          <Name>AnodeOutletNotConnected</Name>
          <Condition>MC</Condition>
          <Expression>AnoIn.NumberOfConnections = 1 and AnoOut.NumberOfConnections = 0</Expression>
          <Severity>Warning</Severity>
          <DisplayMessage>ElectroRig anode outlet must be connected for Fluid Flow and Dynamics modes.</DisplayMessage>
        </Message>
        <Message>
          <Name>ModeCheckCathode</Name>
          <Condition>MCCat</Condition>
          <Expression>CatInSetP &gt; 0.5</Expression>
          <Severity>Warning</Severity>
          <DisplayMessage>Add a flow calculating model to cathode inlet stream such as a pipe or valve, or set the Stream Flow Resistance, for Fluid Flow and Dynamics modes.</DisplayMessage>
        </Message>
        <Message>
          <Name>ModeCheckAnode</Name>
          <Condition>MCAno</Condition>
          <Expression>AnoInSetP &gt; 0.5</Expression>
          <Severity>Warning</Severity>
          <DisplayMessage>Add a flow calculating model to anode inlet stream such as a pipe or valve, or set the Stream Flow Resistance, for Fluid Flow and Dynamics modes.</DisplayMessage>
        </Message>
      </Messages>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
            <Image>
              <Name>Default</Name>
