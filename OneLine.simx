    </Model>
    <Model>
      <Type>PFRElem</Type>
      <Description>Plug flow reactor element (mixed zone)</Description>
      <NamePrefix>R</NamePrefix>
      <NameStartingNumber>1</NameStartingNumber>
      <Parameters>
        <Parameter>
          <Name>FluidType</Name>
          <Description>PFRElem fluid type</Description>
          <Type>FluidType</Type>
          <Default>Process.DefFluid</Default>
        </Parameter>
        <Parameter>
          <Name>FluidReactions</Name>
          <Description>PFRElem option to include or ignore fluid state reactions</Description>
          <Type>Enumeration</Type>
          <Default>Include</Default>
          <Values>
            <Value>Ignore</Value>
            <Value>Include</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>Basis</Name>
          <Description>PFRElem reactor basis for the reaction rate, either by volume or catalyst weight</Description>
          <Type>Enumeration</Type>
          <Default>Volume</Default>
          <Values>
            <Value>Volume</Value>
            <Value>CatalystMass</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>RxnModelType</Name>
          <Description>PFRElem reaction model type for reaction stoichiometry for bulk phase holdup</Description>
          <Type>ModelType</Type>
          <Default>Process.DefKinetics</Default>
        </Parameter>
        <Parameter>
          <Name>RxnModelTypeV</Name>
          <Description>PFRElem reaction model type for reaction stoichiometry for vapor phase holdup</Description>
          <Type>ModelType</Type>
          <Default>Process.DefKinetics</Default>
        </Parameter>
        <Parameter>
          <Name>RxnModelTypeL1</Name>
          <Description>PFRElem reaction model type for reaction stoichiometry for liquid1 phase holdup</Description>
          <Type>ModelType</Type>
          <Default>Process.DefKinetics</Default>
        </Parameter>
        <Parameter>
          <Name>RxnModelTypeL2</Name>
          <Description>PFRElem reaction model type for reaction stoichiometry for liquid2 phase holdup</Description>
          <Type>ModelType</Type>
          <Default>Process.DefKinetics</Default>
        </Parameter>
        <Parameter>
          <Name>Thermophysical</Name>
          <Description>PFRElem flag for thermophysical state properties. Do not modify.</Description>
          <Type>Enumeration</Type>
          <Default>Show</Default>
          <Values>
            <Value>Show</Value>
          </Values>
        </Parameter>
      </Parameters>
      <Conditions>
        <Condition>
          <Name>Pro</Name>
          <Expression>MODE = Process</Expression>
        </Condition>
        <Condition>
          <Name>FFD</Name>
          <Expression>MODE = FluidFlow or MODE = Dynamics</Expression>
        </Condition>
        <Condition>
          <Name>BasisCatMass</Name>
          <Expression>Basis = CatalystMass</Expression>
        </Condition>
        <Condition>
          <Name>BasisVolume</Name>
          <Expression>Basis = Volume</Expression>
        </Condition>
        <Condition>
          <Name>C</Name>
          <Expression>false</Expression>
        </Condition>
        <Condition>
          <Name>VLLE</Name>
          <Expression>FluidType.Phase = VLLE or FluidType.Phase = VLWE</Expression>
        </Condition>
        <Condition>
          <Name>VLE</Name>
          <Expression>FluidType.Phase = VLE</Expression>
        </Condition>
        <Condition>
          <Name>ProVLLE</Name>
          <Expression>Pro and VLLE</Expression>
        </Condition>
        <Condition>
          <Name>ProVLE</Name>
          <Expression>Pro and VLE</Expression>
        </Condition>
        <Condition>
          <Name>FFDVLLE</Name>
          <Expression>FFD and VLLE</Expression>
        </Condition>
        <Condition>
          <Name>FFDVLE</Name>
          <Expression>FFD and VLE</Expression>
        </Condition>
        <Condition>
          <Name>RxnFluid</Name>
          <Expression>FluidType.ReactionModel &lt;&gt; "" and FluidType.ReactionModel &lt;&gt; "Process.DefEQ" and FluidType.ReactionModel &lt;&gt; "Process.DefRate" and FluidType.ReactionModel &lt;&gt; "Process.DefKinetics" and FluidType.Class = Compositional and FluidReactions = Include</Expression>
        </Condition>
        <Condition>
          <Name>RxnModelOnly</Name>
          <Expression>not RxnFluid</Expression>
        </Condition>
        <Condition>
          <Name>RxnAllCM_VLLE</Name>
          <Expression>RxnFluid and BasisCatMass and VLLE</Expression>
        </Condition>
        <Condition>
          <Name>RxnAllVol_VLLE</Name>
          <Expression>RxnFluid and BasisVolume and VLLE</Expression>
        </Condition>
        <Condition>
          <Name>RxnAllCM_VLE</Name>
          <Expression>RxnFluid and BasisCatMass and VLE</Expression>
        </Condition>
        <Condition>
          <Name>RxnAllVol_VLE</Name>
          <Expression>RxnFluid and BasisVolume and VLE</Expression>
        </Condition>
        <Condition>
          <Name>RxnModelOnlyCM_VLLE</Name>
          <Expression>RxnModelOnly and BasisCatMass and VLLE</Expression>
        </Condition>
        <Condition>
          <Name>RxnModelOnlyVol_VLLE</Name>
          <Expression>RxnModelOnly and BasisVolume and VLLE</Expression>
        </Condition>
        <Condition>
          <Name>RxnModelOnlyCM_VLE</Name>
          <Expression>RxnModelOnly and BasisCatMass and VLE</Expression>
        </Condition>
        <Condition>
          <Name>RxnModelOnlyVol_VLE</Name>
          <Expression>RxnModelOnly and BasisVolume and VLE</Expression>
        </Condition>
      </Conditions>
      <Connections>
        <Connection>
          <Name>Conn1</Name>
          <Type>Parameter</Type>
          <From>In.FluidType</From>
          <To>FluidType</To>
        </Connection>
        <Connection>
          <Name>Conn2</Name>
          <Type>Parameter</Type>
          <From>In.FluidType</From>
          <To>Out.FluidType</To>
        </Connection>
        <Connection>
          <Name>Conn3</Name>
          <Type>Parameter</Type>
          <From>In.FluidType</From>
          <To>State.FluidType</To>
        </Connection>
        <Connection>
          <Name>Conn4</Name>
          <Type>Variable</Type>
          <From>P</From>
          <To>State.P</To>
        </Connection>
        <Connection>
          <Name>Conn5</Name>
          <Type>Variable</Type>
          <From>Out.z</From>
          <To>State.z</To>
        </Connection>
        <Connection>
          <Name>Conn6</Name>
          <Type>Variable</Type>
          <From>Out.H</From>
          <To>State.H</To>
        </Connection>
        <Connection>
          <Name>Conn13</Name>
          <Type>Variable</Type>
          <From>T</From>
          <To>State.T</To>
        </Connection>
        <Connection>
          <Name>Conn14</Name>
          <Type>Variable</Type>
          <From>In.zr</From>
          <To>State.z</To>
        </Connection>
        <Connection>
          <Name>Conn15</Name>
          <Type>Variable</Type>
          <From>In.Hr</From>
          <To>State.H</To>
        </Connection>
        <Connection>
          <Name>Conn8</Name>
          <Type>Variable</Type>
          <From>P</From>
          <To>Rxn.P</To>
        </Connection>
        <Connection>
          <Name>Conn10</Name>
          <Type>Variable</Type>
          <From>T</From>
          <To>Rxn.T</To>
        </Connection>
        <Connection>
          <Name>Conn12</Name>
          <Type>Variable</Type>
          <From>State.z</From>
          <To>Rxn.z</To>
        </Connection>
        <Connection>
          <Name>Conn9</Name>
          <Type>Variable</Type>
          <From>rho</From>
          <To>State.rho</To>
        </Connection>
        <Connection>
          <Name>Conn11</Name>
          <Type>Variable</Type>
          <From>MW</From>
          <To>State.MW</To>
        </Connection>
        <Connection>
          <Name>Conn16</Name>
          <Type>Variable</Type>
          <From>mu</From>
          <To>State.mu</To>
        </Connection>
        <Connection>
          <Name>Conn7</Name>
          <Type>Parameter</Type>
          <From>FluidType</From>
          <To>Rxn.FluidType</To>
        </Connection>
        <Connection>
          <Name>Conn17</Name>
          <Type>Variable</Type>
          <From>P</From>
          <To>Out.P</To>
        </Connection>
        <Connection>
          <Name>Conn27</Name>
          <Type>Parameter</Type>
          <From>FluidType</From>
          <To>RxnV.FluidType</To>
        </Connection>
        <Connection>
          <Name>Conn18</Name>
          <Type>Variable</Type>
          <From>P</From>
          <To>RxnV.P</To>
        </Connection>
        <Connection>
          <Name>Conn19</Name>
          <Type>Variable</Type>
          <From>T</From>
          <To>RxnV.T</To>
        </Connection>
        <Connection>
          <Name>Conn20</Name>
          <Type>Variable</Type>
          <From>State.z</From>
          <To>RxnV.z</To>
        </Connection>
        <Connection>
          <Name>Conn28</Name>
          <Type>Parameter</Type>
          <From>FluidType</From>
          <To>RxnL1.FluidType</To>
        </Connection>
        <Connection>
          <Name>Conn21</Name>
          <Type>Variable</Type>
          <From>P</From>
          <To>RxnL1.P</To>
        </Connection>
        <Connection>
          <Name>Conn22</Name>
          <Type>Variable</Type>
          <From>T</From>
          <To>RxnL1.T</To>
        </Connection>
        <Connection>
          <Name>Conn23</Name>
          <Type>Variable</Type>
          <From>State.z</From>
          <To>RxnL1.z</To>
        </Connection>
        <Connection>
          <Name>Conn29</Name>
          <Type>Parameter</Type>
          <From>FluidType</From>
          <To>RxnL2.FluidType</To>
        </Connection>
        <Connection>
          <Name>Conn24</Name>
          <Type>Variable</Type>
          <From>P</From>
          <To>RxnL2.P</To>
        </Connection>
        <Connection>
          <Name>Conn25</Name>
          <Type>Variable</Type>
          <From>T</From>
          <To>RxnL2.T</To>
        </Connection>
        <Connection>
          <Name>Conn26</Name>
          <Type>Variable</Type>
          <From>State.z</From>
          <To>RxnL2.z</To>
        </Connection>
        <Connection>
          <Name>Conn30</Name>
          <Type>Parameter</Type>
          <From>Thermophysical</From>
          <To>State.Thermophysical</To>
        </Connection>
        <Connection>
          <Name>Conn31</Name>
          <Condition>RxnFluid</Condition>
          <Type>Parameter</Type>
          <From>FluidType</From>
          <To>RxnGlobal.FluidType</To>
        </Connection>
        <Connection>
          <Name>Conn32</Name>
          <Condition>RxnFluid</Condition>
          <Type>Variable</Type>
          <From>P</From>
          <To>RxnGlobal.P</To>
        </Connection>
        <Connection>
          <Name>Conn33</Name>
          <Condition>RxnFluid</Condition>
          <Type>Variable</Type>
          <From>T</From>
          <To>RxnGlobal.T</To>
        </Connection>
        <Connection>
          <Name>Conn34</Name>
          <Condition>RxnFluid</Condition>
          <Type>Variable</Type>
          <From>State.z</From>
          <To>RxnGlobal.z</To>
        </Connection>
        <Connection>
          <Name>Conn35</Name>
          <Condition>RxnFluid</Condition>
          <Type>Variable</Type>
          <From>State.x</From>
          <To>RxnGlobal.x</To>
        </Connection>
        <Connection>
          <Name>Conn36</Name>
          <Condition>RxnFluid</Condition>
          <Type>Variable</Type>
          <From>State.y</From>
          <To>RxnGlobal.y</To>
        </Connection>
        <Connection>
          <Name>Conn37</Name>
          <Condition>RxnFluid</Condition>
          <Type>Variable</Type>
          <From>State.gammal</From>
          <To>RxnGlobal.gamma</To>
        </Connection>
        <Connection>
          <Name>RxnGlobalState</Name>
          <Condition>RxnFluid</Condition>
          <Type>Model</Type>
          <From>State</From>
          <To>RxnGlobal.StateX</To>
        </Connection>
        <Connection>
          <Name>RxnState</Name>
          <Type>Model</Type>
          <From>State</From>
          <To>Rxn.StateX</To>
        </Connection>
        <Connection>
          <Name>RxnVState</Name>
          <Type>Model</Type>
          <From>State</From>
          <To>RxnV.StateX</To>
        </Connection>
        <Connection>
          <Name>RxnL1State</Name>
          <Type>Model</Type>
          <From>State</From>
          <To>RxnL1.StateX</To>
        </Connection>
        <Connection>
          <Name>RxnL2State</Name>
          <Condition>VLLE</Condition>
          <Type>Model</Type>
          <From>State</From>
          <To>RxnL2.StateX</To>
        </Connection>
      </Connections>
      <Variables>
        <Variable>
          <Name>P</Name>
          <Description>PFRElem pressure</Description>
          <Type>Pressure</Type>
          <Min>FluidType.PMin</Min>
          <Max>FluidType.PMax</Max>
        </Variable>
        <Variable>
          <Name>DP</Name>
          <Description>PFRElem pressure drop</Description>
          <Type>Diff Pressure</Type>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>V</Name>
          <Description>PFRElem bed volume</Description>
          <Type>Volume</Type>
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>Vv</Name>
          <Description>PFRElem vapor volume</Description>
          <Type>Volume</Type>
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>Vl</Name>
          <Description>PFRElem bed liquid volume</Description>
          <Type>Volume</Type>
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>Vl1</Name>
          <Description>PFRElem liquid 1 molar volume</Description>
          <Type>Volume</Type>
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>Vl2</Name>
          <Description>PFRElem liquid 2 molar volume</Description>
          <Type>Volume</Type>
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>eps</Name>
          <Description>PFRElem catalyst void fraction. Eps will affect the conversion when Basis=CatalystMass, and it will affect pressure drop when DPModelType=DPErgun.</Description>
          <Type>Fraction</Type>
        </Variable>
        <Variable>
          <Name>Rate</Name>
          <Description>PFRElem reaction rates </Description>
          <Condition>BasisCatMass</Condition>
          <Type>Mole Flow</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>Rate</Name>
          <Description>PFRElem reaction rates </Description>
          <Condition>BasisVolume</Condition>
          <Type>Mole Flow</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>Duty</Name>
          <Description>PFRElem heat duty</Description>
          <Type>Heat Duty</Type>
          <Group>Operations</Group>
          <Favorite />
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>T</Name>
          <Description>PFRElem temperature</Description>
          <Type>Temperature</Type>
          <Min>FluidType.TMin</Min>
          <Max>FluidType.TMax</Max>
        </Variable>
        <Variable>
          <Name>L</Name>
          <Description>PFRElem bed length</Description>
          <Type>Length</Type>
        </Variable>
        <Variable>
          <Name>tau</Name>
          <Description>PFRElem residence time in element</Description>
          <Type>Time</Type>
          <Max>1000000000</Max>
          <Default>1</Default>
        </Variable>
        <Variable>
          <Name>M</Name>
          <Description>PFRElem molar holdup of each component</Description>
          <Type>Moles</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Min>0</Min>
          <Default>FluidType.Composition</Default>
        </Variable>
        <Variable>
          <Name>E</Name>
          <Description>PFRElem total accumulation of energy</Description>
          <Type>Energy</Type>
        </Variable>
        <Variable>
          <Name>derE</Name>
          <Description>PFRElem total accumulation of energy</Description>
          <Type>Real</Type>
        </Variable>
        <Variable>
          <Name>Mt</Name>
          <Description>PFRElem total molar holdup</Description>
          <Type>Moles</Type>
          <Min>0</Min>
        </Variable>
        <Variable>
          <Name>Mm</Name>
          <Description>PFRElem metal mass</Description>
          <Type>Metal Mass</Type>
        </Variable>
        <Variable>
          <Name>Mc</Name>
          <Description>PFRElem catalyst mass</Description>
          <Type>Metal Mass</Type>
          <Min>0</Min>
        </Variable>
        <Variable>
          <Name>rhoc</Name>
          <Description>PFRElem catalyst density</Description>
          <Type>Mass Density</Type>
        </Variable>
        <Variable>
          <Name>Cpc</Name>
          <Description>PFRElem specific heat capacity of catalyst</Description>
          <Type>Specific Heat</Type>
          <Default>0.68</Default>
        </Variable>
        <Variable>
          <Name>dMdt</Name>
          <Description>PFRElem component molar holdup time derivative</Description>
          <Type>Real</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>rho</Name>
          <Description>PFRElem mass density</Description>
          <Type>Mass Density</Type>
        </Variable>
        <Variable>
          <Name>MW</Name>
          <Description>PFRElem molecular weight</Description>
          <Type>Molar Weight</Type>
        </Variable>
        <Variable>
          <Name>MWin</Name>
          <Description>PFRElem molecular weight of inlet</Description>
          <Type>Molar Weight</Type>
        </Variable>
        <Variable>
          <Name>F</Name>
          <Description>PFRElem molar inlet flow</Description>
          <Type>Mole Flow</Type>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>mu</Name>
          <Description>PFRElem viscosity</Description>
          <Type>Viscosity</Type>
        </Variable>
        <Variable>
          <Name>dEdt</Name>
          <Description>PFRElem energy holdup time derivative</Description>
          <Type>Real</Type>
          <Default>0</Default>
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>DYNPRES</Name>
          <Condition>FFD</Condition>
          <Formula>P = max(In.P, Out.P) - DP</Formula>
        </Equation>
        <Equation>
          <Name>SSPRES</Name>
          <Condition>Pro</Condition>
          <Formula>P = In.P - DP</Formula>
        </Equation>
        <Equation>
          <Name>SSMB</Name>
          <Description>Steady state mole balance</Description>
          <Condition>Pro</Condition>
          <Formula>In.F * In.z + Rate = Out.F * Out.z</Formula>
        </Equation>
        <Equation>
          <Name>Eqn14</Name>
          <Condition>ProVLE</Condition>
          <Formula>In.F * In.H + Duty + Rxn.Heat + RxnV.Heat + RxnL1.Heat = Out.F * Out.H</Formula>
        </Equation>
        <Equation>
          <Name>SSEB</Name>
          <Description>Steady state energy balance</Description>
          <Condition>ProVLLE</Condition>
          <Formula>In.F * In.H + Duty + Rxn.Heat + RxnV.Heat + RxnL1.Heat + RxnL2.Heat = Out.F * Out.H</Formula>
        </Equation>
        <Equation>
          <Name>DYNMB</Name>
          <Description>Dynamic mole balance (bi-directional flow)</Description>
          <Condition>FFD</Condition>
          <Formula>der(M) = In.F * In.z - Out.F * Out.z + Rate</Formula>
        </Equation>
        <Equation>
          <Name>Eqn15</Name>
          <Condition>FFDVLE</Condition>
          <Formula>derE = In.F * In.H - Out.F * Out.H + Duty + Rxn.Heat + RxnV.Heat + RxnL1.Heat</Formula>
        </Equation>
        <Equation>
          <Name>DYNEB</Name>
          <Description>Dynamic energy balance (bi-directional flow)</Description>
          <Condition>FFDVLLE</Condition>
          <Formula>derE = In.F * In.H - Out.F * Out.H + Duty + Rxn.Heat + RxnV.Heat + RxnL1.Heat + RxnL2.Heat</Formula>
        </Equation>
        <Equation>
          <Name>SUMZ</Name>
          <Description>Mole fraction constraint</Description>
          <Formula>sum(Out.z) = 1</Formula>
        </Equation>
        <Equation>
          <Name>MOLES</Name>
          <Description>Relate fluid composition to molar holdup</Description>
          <Formula>M = State.z * Mt</Formula>
        </Equation>
        <Equation>
          <Name>ENERGY</Name>
          <Description>Relate total energy to fluid and catalyst contributions, 0.49 kJ/kg-K is carbon steel specific heat</Description>
          <Formula>E = State.U * Mt + Mc * Cpc * T + Mm * 0.49 * T</Formula>
        </Equation>
        <Equation>
          <Name>VOLUME</Name>
          <Description>Relate total free volume to fluid molar volume</Description>
          <Condition>BasisCatMass</Condition>
          <Formula>V * (1 - eps) = State.V * Mt</Formula>
        </Equation>
        <Equation>
          <Name>Eqn1</Name>
          <Condition>BasisVolume</Condition>
          <Formula>V = State.V * Mt</Formula>
        </Equation>
        <Equation>
          <Name>MASSCAT</Name>
          <Formula>Mc = V * (1 - eps) * rhoc</Formula>
        </Equation>
        <Equation>
          <Name>RESTIME1</Name>
          <Description>Residence time for catalyst mass based reactions</Description>
          <Condition>BasisCatMass</Condition>
          <Formula>Out.F * State.V * tau = V * eps</Formula>
        </Equation>
        <Equation>
          <Name>RESTIME2</Name>
          <Description>Residence time for volume based reactions</Description>
          <Condition>BasisVolume</Condition>
          <Formula>Out.F * State.V * tau = V</Formula>
        </Equation>
        <Equation>
          <Name>DPFlow</Name>
          <Formula>In.F = F</Formula>
        </Equation>
        <Equation>
          <Name>Eqn13</Name>
          <Formula>State.V * Rxn.C = 1</Formula>
        </Equation>
        <Equation>
          <Name>Eqn2</Name>
          <Formula>State.Vv * RxnV.C = 1</Formula>
        </Equation>
        <Equation>
          <Name>Eqn16</Name>
          <Condition>VLE</Condition>
          <Formula>State.Vl * RxnL1.C = 1</Formula>
        </Equation>
        <Equation>
          <Name>Eqn3</Name>
          <Condition>VLLE</Condition>
          <Formula>State.Vl1 * RxnL1.C = 1</Formula>
        </Equation>
        <Equation>
          <Name>Eqn4</Name>
          <Condition>VLLE</Condition>
          <Formula>State.Vl2 * RxnL2.C = 1</Formula>
        </Equation>
        <Equation>
          <Name>Eqn5</Name>
          <Condition>RxnAllVol_VLLE</Condition>
          <Formula>Rate = Rxn.Rate * V + RxnV.Rate * Vv + RxnL1.Rate * Vl1 + RxnL2.Rate * Vl2 + RxnGlobal.Rate</Formula>
        </Equation>
        <Equation>
          <Name>Eqn6</Name>
          <Condition>RxnAllCM_VLLE</Condition>
          <Formula>Rate = Rxn.Rate * Mc + RxnV.Rate * Mc * Vv / V + RxnL1.Rate * Mc * Vl1 / V + RxnL2.Rate * Mc * Vl2 / V + RxnGlobal.Rate</Formula>
        </Equation>
        <Equation>
          <Name>Eqn7</Name>
          <Condition>RxnAllVol_VLE</Condition>
          <Formula>Rate = Rxn.Rate * V + RxnV.Rate * Vv + RxnL1.Rate * Vl + RxnGlobal.Rate</Formula>
        </Equation>
        <Equation>
          <Name>Eqn8</Name>
          <Condition>RxnAllCM_VLE</Condition>
          <Formula>Rate = Rxn.Rate * Mc + RxnV.Rate * Mc * Vv / V + RxnL1.Rate * Mc * Vl / V + RxnGlobal.Rate</Formula>
        </Equation>
        <Equation>
          <Name>Eqn18</Name>
          <Condition>RxnModelOnlyVol_VLLE</Condition>
          <Formula>Rate = Rxn.Rate * V + RxnV.Rate * Vv + RxnL1.Rate * Vl1 + RxnL2.Rate * Vl2</Formula>
        </Equation>
        <Equation>
          <Name>Eqn19</Name>
          <Condition>RxnModelOnlyCM_VLLE</Condition>
          <Formula>Rate = Rxn.Rate * Mc + RxnV.Rate * Mc * Vv / V + RxnL1.Rate * Mc * Vl1 / V + RxnL2.Rate * Mc * Vl2 / V</Formula>
        </Equation>
        <Equation>
          <Name>Eqn20</Name>
          <Condition>RxnModelOnlyVol_VLE</Condition>
          <Formula>Rate = Rxn.Rate * V + RxnV.Rate * Vv + RxnL1.Rate * Vl</Formula>
        </Equation>
        <Equation>
          <Name>Eqn21</Name>
          <Condition>RxnModelOnlyCM_VLE</Condition>
          <Formula>Rate = Rxn.Rate * Mc + RxnV.Rate * Mc * Vv / V + RxnL1.Rate * Mc * Vl / V</Formula>
        </Equation>
        <Equation>
          <Name>Eqn9</Name>
          <Formula>V * State.VL * State.LF = Vl * State.V</Formula>
        </Equation>
        <Equation>
          <Name>Eqn10</Name>
          <Condition>VLLE</Condition>
          <Formula>V * State.Vl2 * State.L2F = Vl2 * State.V</Formula>
        </Equation>
        <Equation>
          <Name>Eqn11</Name>
          <Formula>V = Vv + Vl</Formula>
        </Equation>
        <Equation>
          <Name>Eqn12</Name>
          <Condition>VLLE</Condition>
          <Formula>Vl = Vl1 + Vl2</Formula>
        </Equation>
        <Equation>
          <Name>Eqn17</Name>
          <Formula>der(E) = derE</Formula>
        </Equation>
        <Equation>
          <Name>Eqn22</Name>
          <Formula>MWin = sum(In.z * FluidType.MW)</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>State</Name>
          <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
        </Model>
        <Model>
          <Name>RxnGlobal</Name>
          <Condition>RxnFluid</Condition>
          <ModelTypeParameter>FluidType.ReactionModel</ModelTypeParameter>
        </Model>
        <Model>
          <Name>Rxn</Name>
          <ModelTypeParameter>RxnModelType</ModelTypeParameter>
        </Model>
        <Model>
          <Name>RxnV</Name>
          <ModelTypeParameter>RxnModelTypeV</ModelTypeParameter>
        </Model>
        <Model>
          <Name>RxnL1</Name>
          <ModelTypeParameter>RxnModelTypeL1</ModelTypeParameter>
        </Model>
        <Model>
          <Name>RxnL2</Name>
          <Condition>VLLE</Condition>
          <ModelTypeParameter>RxnModelTypeL2</ModelTypeParameter>
        </Model>
      </Models>
      <Ports>
        <Port>
          <Name>In</Name>
          <Library Version="9.1.0">Submodels</Library>
          <Type>FlowPort</Type>
        </Port>
        <Port>
          <Name>Out</Name>
          <Direction>Out</Direction>
          <Library Version="9.1.0">Submodels</Library>
          <Type>FlowPort</Type>
        </Port>
      </Ports>
      <Groups>
        <Group>
          <Name>Operations</Name>
        </Group>
      </Groups>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
