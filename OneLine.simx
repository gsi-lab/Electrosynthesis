          <Type>FluidType</Type>
          <Default>Fluid1</Default>
        </Parameter>
        <Parameter>
          <Name>R</Name>
          <Description>DefKinetics gas constant</Description>
          <Type>Molar Entropy</Type>
          <Default>8.314</Default>
          <Max>10</Max>
        </Parameter>
        <Parameter>
          <Name>Nrxn</Name>
          <Description>DefKinetics number of reactions</Description>
