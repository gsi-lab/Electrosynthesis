    <Model>
      <Type>Kinetics1</Type>
      <Description>Electrocarboxylation_Anode
</Description>
      <NamePrefix>R</NamePrefix>
      <NameStartingNumber>1</NameStartingNumber>
      <IsReplaceableModel />
      <Parameters>
        <Parameter>
          <Name>FluidType</Name>
          <Description>DefKinetics fluid type</Description>
          <Type>FluidType</Type>
          <Default>Fluid1</Default>
        </Parameter>
        <Parameter>
          <Name>R</Name>
          <Description>DefKinetics gas constant</Description>
          <Type>Molar Entropy</Type>
          <Default>8.314</Default>
          <Max>10</Max>
        </Parameter>
        <Parameter>
          <Name>Nrxn</Name>
          <Description>DefKinetics number of reactions</Description>
          <Type>Integer</Type>
          <Default>1</Default>
          <Max>100</Max>
          <Min>1</Min>
        </Parameter>
        <Parameter>
          <Name>F</Name>
          <Type>Electrical Charge</Type>
          <Default>96485000</Default>
          <Max>10000000000</Max>
        </Parameter>
        <Parameter>
          <Name>n</Name>
          <Type>Dimensionless</Type>
          <Default>2</Default>
          <Max>5</Max>
        </Parameter>
        <Parameter>
          <Name>FaradaicEfficiency</Name>
          <Type>Dimensionless</Type>
          <Default>1</Default>
          <Global />
          <Max>1</Max>
        </Parameter>
        <Parameter>
          <Name>UnitCorrection</Name>
          <Type>Moles</Type>
          <Default>1</Default>
        </Parameter>
        <Parameter>
          <Name>D</Name>
          <Type>Diffusivity</Type>
          <Default>3E-10</Default>
          <Global />
          <Max>1</Max>
          <Min>-1</Min>
        </Parameter>
        <Parameter>
          <Name>density</Name>
          <Type>Standard Liquid Density</Type>
          <Default>1410</Default>
        </Parameter>
        <Parameter>
          <Name>viscosity</Name>
          <Type>Viscosity</Type>
          <Default>0.035</Default>
        </Parameter>
        <Parameter>
          <Name>Eeq</Name>
          <Type>Voltage</Type>
          <Default>-0.0014</Default>
          <Global />
          <Min>-10</Min>
        </Parameter>
        <Parameter>
          <Name>scanVolt</Name>
          <Type>Voltage</Type>
          <Default>0.0005</Default>
          <Max>1</Max>
        </Parameter>
        <Parameter>
          <Name>scantime</Name>
          <Type>Time</Type>
          <Default>1</Default>
          <Max>3</Max>
        </Parameter>
        <Parameter>
          <Name>alfa</Name>
          <Type>Dimensionless</Type>
          <Default>0.37</Default>
          <Max>1</Max>
        </Parameter>
        <Parameter>
          <Name>Epc</Name>
          <Type>Voltage</Type>
          <Default>-0.00166</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>E0_anode</Name>
          <Type>Voltage</Type>
          <Default>0.00123</Default>
        </Parameter>
        <Parameter>
          <Name>k0_anode</Name>
          <Type>Velocity</Type>
          <Default>1E-09</Default>
        </Parameter>
        <Parameter>
          <Name>n_anode</Name>
          <Type>Dimensionless</Type>
          <Default>4</Default>
        </Parameter>
        <Parameter>
          <Name>alfa_anode</Name>
          <Type>Dimensionless</Type>
          <Default>0.5</Default>
        </Parameter>
        <Parameter>
          <Name>D_anode</Name>
          <Type>Diffusivity</Type>
          <Default>2.1E-09</Default>
        </Parameter>
        <Parameter>
          <Name>density_anode</Name>
          <Type>Standard Liquid Density</Type>
          <Default>997</Default>
        </Parameter>
        <Parameter>
          <Name>viscosity_anode</Name>
          <Type>Viscosity</Type>
          <Default>0.00089</Default>
        </Parameter>
      </Parameters>
      <Conditions>
        <Condition>
          <Name>CC</Name>
          <Expression>false</Expression>
        </Condition>
      </Conditions>
      <Variables>
        <Variable>
          <Name>P</Name>
          <Description>DefKinetics pressure</Description>
          <Type>Pressure</Type>
          <Min>FluidType.PMin</Min>
          <Max>FluidType.PMax</Max>
          <Default>FluidType.Pressure</Default>
        </Variable>
        <Variable>
          <Name>T2</Name>
          <Description>DefKinetics temperature</Description>
          <Type>Temperature</Type>
          <Min>FluidType.TMin</Min>
          <Max>FluidType.TMax</Max>
          <Default>FluidType.Temperature</Default>
        </Variable>
        <Variable>
          <Name>z</Name>
          <Description>DefKinetics molar bulk phase composition</Description>
          <Type>Molar Composition</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>FluidType.Composition</Default>
        </Variable>
        <Variable>
          <Name>C</Name>
          <Description>DefKinetics molar bulk phase concentration</Description>
          <Type>Molar Concentration</Type>
        </Variable>
        <Variable>
          <Name>Rate</Name>
          <Description>DefKinetics component reaction rates</Description>
          <Type>Reaction Rate per Volume</Type>
          <Dimension>FluidType.CompList</Dimension>
        </Variable>
        <Variable>
          <Name>Reaction</Name>
          <Description>DefKinetics Reaction factor</Description>
          <Type>Fraction</Type>
        </Variable>
        <Variable>
          <Name>V</Name>
          <Type>Volume</Type>
          <UplevelReference />
          <Min>1E-06</Min>
        </Variable>
        <Variable>
          <Name>Cx</Name>
          <Type>Molar Concentration</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>FluidType.Composition</Default>
        </Variable>
        <Variable>
          <Name>Heat</Name>
          <Type>Heat Duty</Type>
        </Variable>
        <Variable>
          <Name>Ax</Name>
          <Type>Surface Area</Type>
          <Min>1E-20</Min>
        </Variable>
        <Variable>
          <Name>L</Name>
          <Type>Length</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>ds</Name>
          <Type>Length</Type>
          <UplevelReference />
          <Default>0.01</Default>
        </Variable>
        <Variable>
          <Name>W</Name>
          <Type>Length</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>ActiveRatio</Name>
          <Type>Dimensionless</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>km</Name>
          <Type>Velocity</Type>
        </Variable>
        <Variable>
          <Name>dH</Name>
          <Type>Diameter</Type>
        </Variable>
        <Variable>
          <Name>Re</Name>
          <Type>Real</Type>
          <Max>1000000000</Max>
        </Variable>
        <Variable>
          <Name>Sc</Name>
          <Type>Real</Type>
          <Max>1000000000</Max>
        </Variable>
        <Variable>
          <Name>Sh</Name>
          <Type>Real</Type>
          <Max>1000000000</Max>
        </Variable>
        <Variable>
          <Name>u</Name>
          <Type>Velocity</Type>
        </Variable>
        <Variable>
          <Name>tau</Name>
          <Type>Time</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>NicholsonParam</Name>
          <Type>Real</Type>
        </Variable>
        <Variable>
          <Name>k0</Name>
          <Type>Velocity</Type>
        </Variable>
        <Variable>
          <Name>T</Name>
          <Type>Temperature</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>keff</Name>
          <Type>Velocity</Type>
        </Variable>
        <Variable>
          <Name>Eop</Name>
          <Type>Voltage</Type>
        </Variable>
        <Variable>
          <Name>imax</Name>
          <Type>Current Density</Type>
        </Variable>
        <Variable>
          <Name>DP</Name>
          <Type>Pressure</Type>
        </Variable>
        <Variable>
          <Name>km_anode</Name>
          <Type>Velocity</Type>
        </Variable>
        <Variable>
          <Name>keff_anode</Name>
          <Type>Velocity</Type>
        </Variable>
        <Variable>
          <Name>Eop_anode</Name>
          <Type>Voltage</Type>
        </Variable>
        <Variable>
          <Name>imax_anode</Name>
          <Type>Current Density</Type>
        </Variable>
        <Variable>
          <Name>Re_anode</Name>
          <Type>Real</Type>
        </Variable>
        <Variable>
          <Name>Sc_anode</Name>
          <Type>Real</Type>
        </Variable>
        <Variable>
          <Name>Sh_anode</Name>
          <Type>Real</Type>
        </Variable>
        <Variable>
          <Name>i_anode</Name>
          <Type>Current Density</Type>
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>Eqn1</Name>
          <Formula>Rate[not{"H2O","O2"}]=0</Formula>
        </Equation>
        <Equation>
          <Name>Eqn3</Name>
          <Formula>dH=2*ds*W/(ds+W)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn14</Name>
          <Formula>Rate["H2O"]=-2*FaradaicEfficiency*(Cx["H2O"]*keff_anode)/(1+keff_anode/km_anode)*(ActiveRatio/ds)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn16</Name>
          <Formula>keff_anode=k0_anode*exp((alfa_anode*n_anode*(F/UnitCorrection)*(Eop_anode-E0_anode))/(R*T))</Formula>
        </Equation>
        <Equation>
          <Name>Eqn17</Name>
          <Formula>Eop_anode=E0_anode+R*T/(alfa_anode*n_anode*(F/UnitCorrection))*ln(i_anode*km_anode/(k0_anode*(imax_anode-i_anode)))</Formula>
        </Equation>
        <Equation>
          <Name>Eqn19</Name>
          <Formula>km_anode=Sh_anode*D_anode/dH</Formula>
        </Equation>
        <Equation>
          <Name>Eqn20</Name>
          <Formula>Sh_anode=3*1.85*(Re_anode*Sc_anode*dH/L)^(0.33)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn21</Name>
          <Formula>Re_anode=density_anode*dH/viscosity_anode</Formula>
        </Equation>
        <Equation>
          <Name>Eqn22</Name>
          <Formula>Sc_anode=viscosity_anode/(density_anode*D_anode)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn2</Name>
          <Formula>Cx = StateX.x/max(1E-12, StateX.Vl)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn5</Name>
          <Formula>u=V/40/tau/(W*ds)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn4</Name>
          <Formula>Rate["O2"]=1*FaradaicEfficiency*(Cx["H2O"]*keff_anode)/(1+keff_anode/km_anode)*(ActiveRatio/ds)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn6</Name>
          <Formula>imax_anode=n*(F/UnitCorrection)*Cx["H2O"]*km_anode</Formula>
        </Equation>
        <Equation>
          <Name>Eqn7</Name>
          <Formula>DP=(12*viscosity*L*u/ds^2)*0.001</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>StateX</Name>
          <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
        </Model>
      </Models>
